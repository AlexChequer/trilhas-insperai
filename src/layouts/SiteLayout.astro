---
import Base from "./Base.astro";
import BarraTopo from "../components/BarraTopo.astro";
import Busca from "../components/Busca.astro";
import { getCollection } from "astro:content";
import { BLOCOS } from "../data/aulas";

interface Props {
  title: string;
  descricao?: string;
  /** Aula ou guia atual, para destacar no índice. */
  slugAtual?: string;
  /** Seção ativa na barra do topo. */
  secao?: "aulas" | "projetos" | "recursos";
  /** A home não tem índice lateral: é página inteira. */
  semLateral?: boolean;
}
const { title, descricao, slugAtual, secao, semLateral = false } = Astro.props;

const escritas = new Set((await getCollection("aulas")).map((e) => e.id));
// Material de consulta fora do arco — abre o índice, acima dos blocos.
const guias = (await getCollection("guias")).sort((a, b) => a.data.ordem - b.data.ordem);
---

<Base title={title} descricao={descricao}>
  <div class={"app" + (semLateral ? " sem-lateral" : "")}>
    <BarraTopo secao={secao} temLateral={!semLateral} />

    {
      !semLateral && (
        <aside class="sidebar" data-sidebar>
          <nav class="sidebar-nav" aria-label="Índice das aulas">
            {guias.length > 0 && (
              <div class="nav-bloco">
                <p class="nav-bloco-titulo">Antes de começar</p>
                {guias.map((g) => {
                  const ativa = g.id === slugAtual;
                  return (
                    <a
                      href={`/guias/${g.id}`}
                      class={"nav-aula" + (ativa ? " ativa" : "")}
                      aria-current={ativa ? "page" : undefined}
                    >
                      <span class="nav-aula-codigo">{g.data.codigo}</span>
                      <span class="nav-aula-titulo">{g.data.rotulo}</span>
                    </a>
                  );
                })}
              </div>
            )}
            {BLOCOS.map((bloco) => (
              <div class="nav-bloco">
                <p class="nav-bloco-titulo">{bloco.nome}</p>
                {bloco.aulas.map((a) => {
                  const ativa = a.slug === slugAtual;
                  const temPagina = escritas.has(a.slug);
                  const cls = "nav-aula" + (ativa ? " ativa" : "") + (temPagina ? "" : " muda");
                  return temPagina ? (
                    <a href={`/aulas/${a.slug}`} class={cls} aria-current={ativa ? "page" : undefined}>
                      <span class="nav-aula-codigo">{a.n}</span>
                      <span class="nav-aula-titulo">{a.titulo}</span>
                    </a>
                  ) : (
                    <span class={cls}>
                      <span class="nav-aula-codigo">{a.n}</span>
                      <span class="nav-aula-titulo">{a.titulo}</span>
                    </span>
                  );
                })}
              </div>
            ))}
          </nav>
        </aside>
      )
    }

    <div class="sidebar-backdrop" data-backdrop></div>

    <main class="main">
      <slot />
    </main>
  </div>

  <Busca />

  <script>
    // Bloco de código no padrão GitHub: o <pre> que o Shiki gera é envolvido
    // num contêiner com barra (linguagem + botão de copiar). Feito em JS porque
    // o Markdown do MDX não tem como emitir essa estrutura sozinho.
    const NOMES: Record<string, string> = {
      python: "Python",
      bash: "Terminal",
      sh: "Terminal",
      shell: "Terminal",
      console: "Terminal",
      powershell: "PowerShell",
      js: "JavaScript",
      ts: "TypeScript",
      json: "JSON",
      yaml: "YAML",
      css: "CSS",
      html: "HTML",
    };

    document.querySelectorAll<HTMLElement>(".leitura pre.astro-code").forEach((pre) => {
      const idioma = pre.dataset.language ?? "";
      const caixa = document.createElement("div");
      caixa.className = "bloco-codigo";

      const barra = document.createElement("div");
      barra.className = "bloco-codigo-barra";

      const rotulo = document.createElement("span");
      rotulo.className = "bloco-codigo-lang";
      rotulo.textContent = NOMES[idioma] ?? (idioma || "código");

      const botao = document.createElement("button");
      botao.type = "button";
      botao.className = "btn-copiar";
      botao.textContent = "Copiar";
      botao.setAttribute("aria-label", "Copiar o código");

      let voltar: number | undefined;
      botao.addEventListener("click", async () => {
        const texto = pre.querySelector("code")?.innerText ?? "";
        try {
          await navigator.clipboard.writeText(texto);
          botao.textContent = "Copiado!";
          botao.classList.add("copiado");
        } catch {
          // clipboard bloqueado (http, permissão negada): seleciona para o
          // usuário copiar à mão em vez de fingir que deu certo
          const alvo = pre.querySelector("code");
          if (alvo) {
            const faixa = document.createRange();
            faixa.selectNodeContents(alvo);
            const selecao = window.getSelection();
            selecao?.removeAllRanges();
            selecao?.addRange(faixa);
          }
          botao.textContent = "Selecionado";
        }
        window.clearTimeout(voltar);
        voltar = window.setTimeout(() => {
          botao.textContent = "Copiar";
          botao.classList.remove("copiado");
        }, 1800);
      });

      barra.append(rotulo, botao);
      pre.replaceWith(caixa);
      caixa.append(barra, pre);
    });
  </script>

  <script>
    // Drawer no celular.
    const btn = document.querySelector("[data-menu]");
    const sidebar = document.querySelector("[data-sidebar]");
    const backdrop = document.querySelector("[data-backdrop]");
    const abrir = () => {
      sidebar?.classList.add("aberta");
      backdrop?.classList.add("visivel");
    };
    const fechar = () => {
      sidebar?.classList.remove("aberta");
      backdrop?.classList.remove("visivel");
    };
    btn?.addEventListener("click", abrir);
    backdrop?.addEventListener("click", fechar);
    sidebar?.querySelectorAll("a").forEach((a) => a.addEventListener("click", fechar));
  </script>
</Base>
