---
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props {
  title: string;
  descricao?: string;
}
const {
  title,
  descricao = "Visualizações interativas do programa de trainee da InsperAI.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descricao} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
