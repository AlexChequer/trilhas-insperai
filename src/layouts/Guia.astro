---
// Página de material de consulta (Aula 0, e depois a trilha de setup). Mesma
// leitura das aulas, sem o prev/next do arco — um guia não tem "próxima aula".
// O que ele tem é uma saída: a primeira aula da trilha, quando já existe.
import SiteLayout from "./SiteLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { daTrilha, separarId, urlAula, urlTrilha, type Trilha } from "../data/trilhas";

interface Props {
  data: CollectionEntry<"guias">["data"];
  trilha: Trilha;
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
}
const { data, trilha, slug, headings } = Astro.props;
const secoes = headings.filter((h) => h.depth === 2);

const primeira = (await getCollection("aulas", daTrilha(trilha.id))).sort(
  (a, b) => a.data.ordem - b.data.ordem,
)[0];
---

<SiteLayout
  title={`${data.titulo} — ${trilha.nome}`}
  descricao={data.objetivo}
  trilha={trilha}
  slugAtual={slug}
  secao="aulas"
>
  <div class="aula-doc">
    <article class="conteudo-aula">
      <header class="aula-hero">
        <span class="badge badge-guia">Antes de começar</span>
        <h1>{data.titulo}</h1>
        <p class="objetivo">{data.objetivo}</p>
      </header>

      <div class="leitura">
        <slot />
      </div>

      <nav class="aula-nav">
        <a href={urlTrilha(trilha.id)}>
          <div class="rotulo">Começo</div>
          <div class="nome">← Visão geral do semestre</div>
        </a>
        {
          primeira && (
            <a class="direita" href={urlAula(trilha.id, separarId(primeira.id).slug)}>
              <div class="rotulo">Quando estiver pronto · {primeira.data.n}</div>
              <div class="nome">{primeira.data.titulo} →</div>
            </a>
          )
        }
      </nav>
    </article>

    {
      secoes.length > 0 && (
        <aside class="rail">
          <p class="rail-titulo">Nesta página</p>
          <nav>
            {secoes.map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>
</SiteLayout>
