---
import SiteLayout from "./SiteLayout.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  data: CollectionEntry<"aulas">["data"];
  slug: string;
  prev: CollectionEntry<"aulas"> | null;
  next: CollectionEntry<"aulas"> | null;
  headings: { depth: number; slug: string; text: string }[];
}
const { data, slug, prev, next, headings } = Astro.props;
const secoes = headings.filter((h) => h.depth === 2);
---

<SiteLayout
  title={`Aula ${data.n.slice(1)} · ${data.titulo} — InsperAI`}
  descricao={data.objetivo}
  slugAtual={slug}
  secao="aulas"
>
  <div class="aula-doc">
    <article class="conteudo-aula">
      <header class="aula-hero">
        <span class="badge">{data.n}</span>
        <h1>{data.titulo}</h1>
        <p class="objetivo">{data.objetivo}</p>
      </header>

      <div class="leitura">
        <slot />
      </div>

      <nav class="aula-nav">
        {
          prev ? (
            <a href={`/aulas/${prev.id}`}>
              <div class="rotulo">Anterior · {prev.data.n}</div>
              <div class="nome">← {prev.data.titulo}</div>
            </a>
          ) : (
            <a href="/">
              <div class="rotulo">Começo</div>
              <div class="nome">← Visão geral do semestre</div>
            </a>
          )
        }
        {
          next ? (
            <a class="direita" href={`/aulas/${next.id}`}>
              <div class="rotulo">Próxima · {next.data.n}</div>
              <div class="nome">{next.data.titulo} →</div>
            </a>
          ) : (
            <span class="item-nav direita desativado">
              <div class="rotulo">Próxima</div>
              <div class="nome">em breve</div>
            </span>
          )
        }
      </nav>
    </article>

    {
      secoes.length > 0 && (
        <aside class="rail">
          <p class="rail-titulo">Nesta aula</p>
          <nav>
            {secoes.map((h) => (
              <a href={`#${h.slug}`}>{h.text}</a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>
</SiteLayout>
