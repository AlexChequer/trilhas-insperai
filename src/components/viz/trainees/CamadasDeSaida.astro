---
// Aula 5 · As três camadas de saída lado a lado, alimentadas pelo MESMO z.
// O eixo da aula: a ativação de saída não cria não-linearidade, ela FORMATA a
// resposta. Mexendo num número só dá para ver as três garantias diferentes:
// número livre (regressão), entre 0 e 1 (sigmoid), entre 0 e 1 somando 1 (softmax).
//
// Aqui as barras são CSS, não canvas: não são gráficos de função, são medidores —
// e em CSS ficam mais nítidas no projetor e responsivas de graça.
---

<div class="viz-saidas" data-viz="saidas">
  <div class="stat saidas-controle">
    <div class="slider-campo">
      <label>O que o último neurônio calculou (z) <span class="valor" data-z-val>—</span></label>
      <input type="range" data-z min="-4" max="4" step="0.1" value="1.4" />
    </div>
    <p class="stat-caminho">É o mesmo z entrando nas três colunas. Só muda o que se aplica em cima dele.</p>
  </div>

  <div class="saidas-grade">
    <article class="stat saida-card">
      <p class="stat-rotulo">Regressão</p>
      <p class="saida-config">1 neurônio · <b>sem ativação</b></p>
      <p class="saida-valor" data-reg>—</p>
      <div class="saida-eixo">
        <span class="saida-zero"></span>
        <span class="saida-marca" data-reg-marca></span>
      </div>
      <p class="saida-nota" data-reg-nota>—</p>
      <p class="saida-garantia">Garantia: <b>nenhuma</b>. A saída é o próprio z, e pode ser qualquer número real.</p>
    </article>

    <article class="stat saida-card">
      <p class="stat-rotulo">Classificação binária</p>
      <p class="saida-config">1 neurônio · <b>sigmoid</b></p>
      <p class="saida-valor" data-bin>—</p>
      <div class="saida-barra">
        <span class="saida-fill" data-bin-fill></span>
      </div>
      <p class="saida-nota" data-bin-nota>—</p>
      <p class="saida-garantia">Garantia: <b>entre 0 e 1</b>. Dá para ler como probabilidade de ser da classe 1.</p>
    </article>

    <article class="stat saida-card">
      <p class="stat-rotulo">Multiclasse</p>
      <p class="saida-config">3 neurônios · <b>softmax</b></p>
      <ul class="saida-classes">
        <li>
          <span class="saida-classe-nome">gato</span>
          <span class="saida-barra"><span class="saida-fill" data-c0-fill></span></span>
          <span class="saida-classe-val" data-c0>—</span>
        </li>
        <li>
          <span class="saida-classe-nome">cachorro</span>
          <span class="saida-barra"><span class="saida-fill" data-c1-fill></span></span>
          <span class="saida-classe-val" data-c1>—</span>
        </li>
        <li>
          <span class="saida-classe-nome">pássaro</span>
          <span class="saida-barra"><span class="saida-fill" data-c2-fill></span></span>
          <span class="saida-classe-val" data-c2>—</span>
        </li>
      </ul>
      <p class="saida-nota">soma das três: <b data-soma>—</b></p>
      <p class="saida-garantia">Garantia: <b>entre 0 e 1 e somando 1</b>. As classes disputam a mesma probabilidade.</p>
    </article>
  </div>

  <p class="stat-caminho saidas-fecho" data-fecho></p>
</div>

<style>
  .viz-saidas {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .saidas-grade {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    align-items: start;
  }
  .saida-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .saida-config {
    margin: 0;
    font-size: 0.86rem;
    color: var(--texto-suave);
  }
  .saida-config b {
    color: var(--insper-azul-aco);
  }
  .saida-valor {
    margin: 2px 0 0;
    font-family: var(--fonte-dados);
    font-size: clamp(1.4rem, 3.2vw, 1.85rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--insper-azul-aco);
    line-height: 1.1;
  }
  .saida-nota {
    margin: 0;
    font-size: 0.86rem;
    color: var(--texto-suave);
  }
  .saida-nota b {
    font-family: var(--fonte-dados);
    color: var(--insper-azul-aco);
  }
  .saida-garantia {
    margin: 4px 0 0;
    padding-top: 8px;
    border-top: 1px solid var(--borda);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--texto-suave);
  }

  /* medidor 0–100% (sigmoid e cada classe da softmax) */
  .saida-barra {
    display: block;
    position: relative;
    height: 12px;
    border-radius: 999px;
    background: #eef2f8;
    overflow: hidden;
  }
  .saida-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: 999px;
    background: var(--insper-gradiente);
  }

  /* eixo com zero no meio (regressão: o valor pode ir para os dois lados) */
  .saida-eixo {
    position: relative;
    height: 12px;
    border-radius: 999px;
    background: #eef2f8;
  }
  .saida-zero {
    position: absolute;
    top: -3px;
    bottom: -3px;
    left: 50%;
    width: 2px;
    background: #c7d2e0;
  }
  .saida-marca {
    position: absolute;
    top: -4px;
    width: 20px;
    height: 20px;
    margin-left: -10px;
    border-radius: 50%;
    background: #fff;
    border: 4px solid var(--insper-azul);
    box-shadow: var(--sombra);
    transition: left 0.05s linear;
  }

  .saida-classes {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  /* O card é estreito (1/3 da coluna de leitura): nome e valor numa linha, a
     barra embaixo ocupando a largura toda. Em grade de 3 colunas a barra sumia. */
  .saida-classes li {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "nome valor" "barra barra";
    align-items: center;
    gap: 4px 8px;
  }
  .saida-classes .saida-classe-nome { grid-area: nome; }
  .saida-classes .saida-classe-val { grid-area: valor; }
  .saida-classes .saida-barra { grid-area: barra; }
  .saida-classe-nome {
    font-size: 0.86rem;
    color: var(--texto-suave);
  }
  .saida-classe-val {
    font-family: var(--fonte-dados);
    font-size: 0.9rem;
    font-weight: 700;
    text-align: right;
    color: var(--insper-azul-aco);
  }
  .saida-classes li.vencedora .saida-classe-nome,
  .saida-classes li.vencedora .saida-classe-val {
    color: var(--insper-roxo);
    font-weight: 700;
  }
  .saidas-fecho {
    margin: 0;
  }
  .saida-negativo {
    color: var(--vermelho);
    font-weight: 600;
  }

  @media (max-width: 680px) {
    .saidas-grade {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-viz="saidas"]').forEach((raiz) => {
    const slider = raiz.querySelector<HTMLInputElement>("[data-z]")!;
    const el = (sel: string) => raiz.querySelector<HTMLElement>(`[data-${sel}]`)!;

    // O exemplo do imóvel do curso inteiro: preço-base 300 mil, z em centenas de milhar.
    const PRECO_BASE = 300, PRECO_ESCALA = 100;
    const Z_MIN = -4, Z_MAX = 4;
    // os outros dois logits da multiclasse ficam parados: só o primeiro é o controle
    const LOGITS_FIXOS = [0.4, -0.6];
    const CLASSES = ["gato", "cachorro", "pássaro"];

    const num = (v: number, casas: number) => v.toFixed(casas).replace(".", ",");
    const pct = (v: number) => num(v * 100, 0) + "%";

    function atualizar() {
      const z = parseFloat(slider.value);
      el("z-val").textContent = num(z, 1);

      // --- regressão: a saída É o z, sem nada em cima ---
      const preco = PRECO_BASE + PRECO_ESCALA * z;
      el("reg").textContent = num(z, 2);
      el("reg-marca").style.left = ((z - Z_MIN) / (Z_MAX - Z_MIN)) * 100 + "%";
      el("reg-nota").innerHTML =
        preco < 0
          ? `no exemplo do imóvel: <span class="saida-negativo">R$ ${num(preco, 0)} mil</span> — preço negativo, que o modelo não tem como impedir`
          : `no exemplo do imóvel: <b>R$ ${num(preco, 0)} mil</b>`;

      // --- binária: sigmoid ---
      const p = 1 / (1 + Math.exp(-z));
      el("bin").textContent = num(p, 3);
      el("bin-fill").style.width = p * 100 + "%";
      el("bin-nota").innerHTML = `<b>${pct(p)}</b> de chance de ser da classe 1 · decisão: <b>${p >= 0.5 ? "classe 1" : "classe 0"}</b>`;

      // --- multiclasse: softmax sobre [z, 0.4, −0.6] ---
      const logits = [z, ...LOGITS_FIXOS];
      const maximo = Math.max(...logits); // subtrair o máximo evita estouro no exp
      const exps = logits.map((v) => Math.exp(v - maximo));
      const soma = exps.reduce((s, v) => s + v, 0);
      const probs = exps.map((v) => v / soma);
      const vencedora = probs.indexOf(Math.max(...probs));
      probs.forEach((v, i) => {
        el(`c${i}`).textContent = pct(v);
        el(`c${i}-fill`).style.width = v * 100 + "%";
        const li = el(`c${i}`).closest("li");
        if (li) li.classList.toggle("vencedora", i === vencedora);
      });
      el("soma").textContent = num(probs.reduce((s, v) => s + v, 0), 2);

      el("fecho").innerHTML =
        `Repare no que <strong>não</strong> muda: as três receberam o mesmo z = ${num(z, 1)}. ` +
        `A conta da rede é a mesma até o fim — a ativação de saída só decide em que formato a resposta sai. ` +
        `Agora ela é <strong>${CLASSES[vencedora]}</strong> na multiclasse, e <strong>${p >= 0.5 ? "classe 1" : "classe 0"}</strong> na binária.`;
    }

    slider.addEventListener("input", atualizar);
    atualizar();
  });
</script>
