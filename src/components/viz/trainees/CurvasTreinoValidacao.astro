  }
  .curvas-abaixo .stat-destaque .stat-unidade {
    display: block;
    margin-top: 6px;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .curvas-placar {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.92rem;
    color: var(--texto-suave);
  }
  .curvas-placar li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .curvas-placar i {
    width: 20px;
    height: 4px;
    border-radius: 999px;
    flex: none;
  }
  .curvas-placar b {
    margin-left: auto;
    font-family: var(--fonte-dados);
    font-size: 1.05rem;
    color: var(--insper-azul-aco);
  }
  .curvas-dist {
    padding-top: 8px;
    border-top: 1px solid var(--borda);
  }

  /* ---- elementos do gráfico, criados em JS: tudo em :global() ---- */
  .curvas-svg :global(.g-grade) {
    stroke: var(--borda);
    stroke-width: 1;
  }
  .curvas-svg :global(.g-moldura) {
    fill: none;
    stroke: var(--borda);
    stroke-width: 1.5;
  }
  .curvas-svg :global(.g-eixo-txt) {
    fill: var(--texto-suave);
