    stroke: var(--insper-azul);
  }
  .curvas-svg :global(.g-val) {
    stroke: var(--coral);
  }
  .curvas-svg :global(.g-ponto-treino) {
    fill: var(--insper-azul);
    stroke: var(--superficie);
    stroke-width: 2.5;
  }
  .curvas-svg :global(.g-ponto-val) {
    fill: var(--coral);
    stroke: var(--superficie);
    stroke-width: 2.5;
  }
  .curvas-svg :global(.g-regua) {
    stroke: var(--insper-azul-aco);
    stroke-width: 2;
  }
  .curvas-svg :global(.g-regua-txt) {
    fill: var(--insper-azul-aco);
    font-size: 13px;
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--superficie);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .curvas-svg :global(.g-minimo-linha) {
    stroke: var(--insper-roxo);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
    opacity: 0.7;
  }
  .curvas-svg :global(.g-minimo-ponto) {
    fill: var(--superficie);
    stroke: var(--insper-roxo);
    stroke-width: 3;
  }
  .curvas-svg :global(.g-minimo-txt) {
    fill: var(--insper-roxo);
    font-size: 13px;
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--superficie);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  @media (max-width: 760px) {
    .curvas-controles {
      grid-template-columns: 1fr auto;
    }
    .curvas-slider {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .curvas-abaixo {
      grid-template-columns: 1fr;
    }
  }
</style>

