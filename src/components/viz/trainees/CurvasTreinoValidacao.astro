    };

    // Eixo vertical fixo por cenário (calculado no histórico inteiro, não no
    // trecho revelado): assim, ao animar, as curvas entram e o eixo não pula.
    function escala(h: Ponto[]) {
      if (modo === "loss") {
        const max = Math.max(...h.map((p) => Math.max(p[0], p[1])));
        const passo = max > 1 ? 0.5 : max > 0.3 ? 0.1 : 0.05;
        const topo = Math.ceil(max / passo) * passo;
        return { min: 0, max: topo, passo, fmt: (v: number) => num(v, passo < 0.1 ? 2 : 1) };
      }
      const min = Math.min(...h.map((p) => Math.min(p[2], p[3])));
      const base = Math.floor(min * 10) / 10;
      const passo = 1 - base > 0.4 ? 0.1 : 0.05;
      return { min: base, max: 1, passo, fmt: (v: number) => Math.round(v * 100) + "%" };
    }

    function desenhar() {
      const { hist } = CENARIOS[cenario];
      if (!W) return atualizarPainel(hist, Math.min(ate, hist.length));
      const E = hist.length;
      const n = Math.min(ate, E);
      const ix = modo === "loss" ? [0, 1] : [2, 3];
      const esc = escala(hist);
      const estreito = W < 520;

      const M = { topo: 16, dir: 16, base: 40, esq: modo === "loss" ? 46 : 50 };
      const pw = W - M.esq - M.dir;
      const ph = H - M.topo - M.base;
      const gx = (e: number) => M.esq + (E === 1 ? 0 : ((e - 1) / (E - 1)) * pw);
      const gy = (v: number) => M.topo + (1 - (v - esc.min) / (esc.max - esc.min)) * ph;

      const partes: string[] = [];

      // grade e eixo vertical
      for (let v = esc.min; v <= esc.max + 1e-9; v += esc.passo) {
        const y = gy(v).toFixed(1);
        partes.push(`<line class="g-grade" x1="${M.esq}" x2="${M.esq + pw}" y1="${y}" y2="${y}"/>`);
        partes.push(`<text class="g-eixo-txt" x="${M.esq - 8}" y="${y}" text-anchor="end" dominant-baseline="middle">${esc.fmt(v)}</text>`);
      }
      // eixo horizontal: epochs
      const passoX = E > 30 || estreito ? 10 : 5;
      const marcas = [1];
      for (let e = passoX; e <= E; e += passoX) marcas.push(e);
      for (const e of marcas) {
        partes.push(`<text class="g-eixo-txt" x="${gx(e).toFixed(1)}" y="${M.topo + ph + 18}" text-anchor="middle">${e}</text>`);
      }
      partes.push(`<text class="g-eixo-nome" x="${M.esq + pw / 2}" y="${M.topo + ph + 35}" text-anchor="middle">epoch</text>`);
      partes.push(`<rect class="g-moldura" x="${M.esq}" y="${M.topo}" width="${pw}" height="${ph}"/>`);

      const trecho = hist.slice(0, n);
      const caminho = (k: number) =>
        trecho.map((p, i) => `${i ? "L" : "M"}${gx(i + 1).toFixed(1)},${gy(p[k]).toFixed(1)}`).join("");

      // a faixa entre as duas curvas: é a "distância" que o painel mede
      if (n > 1) {
        const ida = trecho.map((p, i) => `${gx(i + 1).toFixed(1)},${gy(p[ix[0]]).toFixed(1)}`);
        const volta = trecho.map((p, i) => `${gx(i + 1).toFixed(1)},${gy(p[ix[1]]).toFixed(1)}`).reverse();
        partes.push(`<polygon class="g-faixa" points="${[...ida, ...volta].join(" ")}"/>`);
      }

      // o marcador da menor loss de validação (até o epoch revelado)
      const m = epochMinimo(hist, n);
      const xm = gx(m + 1);
      partes.push(`<line class="g-minimo-linha" x1="${xm.toFixed(1)}" x2="${xm.toFixed(1)}" y1="${M.topo}" y2="${M.topo + ph}"/>`);

      partes.push(`<path class="g-linha g-treino" d="${caminho(ix[0])}"/>`);
      partes.push(`<path class="g-linha g-val" d="${caminho(ix[1])}"/>`);

      // a régua da distância, no último epoch revelado
      const ult = trecho[n - 1];
      const xr = gx(n);
      const yT = gy(ult[ix[0]]), yV = gy(ult[ix[1]]);
      partes.push(`<line class="g-regua" x1="${xr.toFixed(1)}" x2="${xr.toFixed(1)}" y1="${yT.toFixed(1)}" y2="${yV.toFixed(1)}"/>`);
      partes.push(`<circle class="g-ponto-treino" cx="${xr.toFixed(1)}" cy="${yT.toFixed(1)}" r="5.5"/>`);
      partes.push(`<circle class="g-ponto-val" cx="${xr.toFixed(1)}" cy="${yV.toFixed(1)}" r="5.5"/>`);
      const dist = modo === "loss" ? num(ult[1] - ult[0], 3) : num((ult[2] - ult[3]) * 100, 1) + " pts";
      const textoDist = `distância ${dist}`;
      const largDist = textoDist.length * 7.4;
      const direita = xr + 10 + largDist < M.esq + pw;
      let yd = (yT + yV) / 2;
      // se as curvas estão coladas, o rótulo sai da frente dos pontos
      if (Math.abs(yT - yV) < 26) yd = Math.min(yT, yV) - 18 > M.topo + 10 ? Math.min(yT, yV) - 18 : Math.max(yT, yV) + 22;
      partes.push(
        `<text class="g-regua-txt" x="${(direita ? xr + 10 : xr - 10).toFixed(1)}" y="${yd.toFixed(1)}" text-anchor="${direita ? "start" : "end"}" dominant-baseline="middle">${textoDist}</text>`,
      );

      // rótulo do mínimo: o ponto só faz sentido no modo loss; na acurácia fica
      // a linha tracejada, para mostrar que a acurácia segue subindo depois dele
      const yMin = gy(hist[m][modo === "loss" ? 1 : 3]);
      if (modo === "loss") {
        partes.push(`<circle class="g-minimo-ponto" cx="${xm.toFixed(1)}" cy="${yMin.toFixed(1)}" r="7"/>`);
      }
      const linhas = modo === "loss"
        ? [`menor loss de validação:`, `${num(hist[m][1], 3)} no epoch ${m + 1}`]
        : [`menor loss de validação`, `(epoch ${m + 1})`];
      const juntas = !estreito ? [linhas.join(" ")] : linhas;
      const largMin = Math.max(...juntas.map((t) => t.length)) * 7.2;
      const ancora = xm + 12 + largMin < M.esq + pw ? "start" : xm - 12 - largMin > M.esq ? "end" : "middle";
      const xt = ancora === "start" ? xm + 12 : ancora === "end" ? xm - 12 : Math.min(Math.max(xm, M.esq + largMin / 2), M.esq + pw - largMin / 2);
      // perto do ponto, mas acima dele; se não couber em cima, embaixo
      const altura = juntas.length * 16;
      let yt = modo === "loss" ? yMin - 22 - (juntas.length - 1) * 16 : M.topo + 16;
      if (modo === "loss" && yt < M.topo + 12) yt = yMin + 24;
      // Com as curvas coladas (underfitting), o mínimo cai no último epoch, em
      // cima do rótulo da distância. Aí ele desce para a área vazia de baixo.
      const xsMin = ancora === "start" ? [xt, xt + largMin] : ancora === "end" ? [xt - largMin, xt] : [xt - largMin / 2, xt + largMin / 2];
      const xsDist = direita ? [xr + 10, xr + 10 + largDist] : [xr - 10 - largDist, xr - 10];
      const cruzaX = xsMin[0] < xsDist[1] && xsDist[0] < xsMin[1];
      if (modo === "loss" && cruzaX && yd > yt - 18 && yd < yt + altura + 2) yt = Math.max(yT, yV) + 40;
      if (modo === "acc" && Math.abs(yt - yd) < altura + 6) yt = M.topo + ph - altura;
      juntas.forEach((t, i) => {
        partes.push(`<text class="g-minimo-txt" x="${xt.toFixed(1)}" y="${(yt + i * 16).toFixed(1)}" text-anchor="${ancora}" dominant-baseline="middle">${t}</text>`);
      });

      svg!.setAttribute("viewBox", `0 0 ${W} ${H}`);
      svg!.setAttribute("height", String(H));
      svg!.innerHTML = partes.join("");

      atualizarPainel(hist, n);
    }

    function atualizarPainel(hist: Ponto[], n: number) {
      const p = hist[n - 1];
      const E = hist.length;
      const mTotal = epochMinimo(hist);
      el("epoch-val").textContent = `${n} de ${E}`;
      el("placar-titulo").textContent = `No epoch ${n}`;
      el("acc-treino").textContent = pct(p[2]);
      el("acc-val").textContent = pct(p[3]);
      el("dist").textContent = `${num((p[2] - p[3]) * 100, 1)} pontos`;
      el("loss-linha").textContent = `loss de treino ${num(p[0], 3)} · loss de validação ${num(p[1], 3)}`;

      // As frases do roteiro, uma por cenário. Antes do mínimo da validação as
      // duas curvas ainda caem juntas e não há o que diagnosticar além disso.
      let diag: string, frase: string;
      if (cenario === "under") {
        diag = "Underfitting";
        frase = modo === "loss"
          ? `As duas altas e coladas: ${num(p[0], 2)} no treino e ${num(p[1], 2)} na validação. Treinar mais quase não ajuda — a rede de 2 neurônios não tem forma para o padrão.`
          : `As duas baixas e coladas: ${pct(p[2])} no treino e ${pct(p[3])} na validação. A rede erra até o que já viu.`;
      } else if (n <= mTotal + 1) {
        diag = "Ainda aprendendo";
        frase = "As duas curvas caem juntas: a rede aprende padrões que valem para qualquer dígito. Continue avançando os epochs até a validação parar de cair.";
      } else if (cenario === "bom") {
        diag = "Bem regularizado";
        frase = modo === "loss"
          ? `A loss de validação oscila e sobe um pouco depois do epoch ${mTotal + 1} (${num(p[1], 3)} agora), bem menos que no treino-base. Dropout e as 50.000 imagens seguram o overfitting.`
          : `Validação em ${pct(p[3])}, ${num((p[2] - p[3]) * 100, 1)} pontos abaixo do treino, e parada nesse patamar: a distância pequena é normal, o que preocupa é ela crescer.`;
      } else if (cenario === "base") {
        diag = "Começo do overfitting";
        frase = `Depois do epoch ${mTotal + 1}, o treino continua caindo e a validação sobe: a rede passou a aprender particularidades das 50.000 imagens de treino. O epoch ${mTotal + 1} era a hora de parar.`;
      } else {
        diag = "Overfitting";
        frase = `Treino no chão, validação longe e subindo: loss ${num(p[0], 4)} no treino contra ${num(p[1], 3)} na validação, e a distância cresce a cada epoch.`;
      }
      el("diag").textContent = diag;
      el("diag-frase").textContent = frase;
    }

    function parar() {
      if (animacao !== null) clearInterval(animacao);
      animacao = null;
      play.textContent = "▶ Animar";
      play.setAttribute("aria-label", "Animar epoch a epoch");
    }

    function trocarCenario(novo: string) {
      parar();
      cenario = novo;
      const E = CENARIOS[novo].hist.length;
      slider.max = String(E);
      ate = E;
      slider.value = String(E);
      raiz.querySelectorAll<HTMLElement>("[data-cenario]").forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.cenario === novo)),
      );
      el("config").textContent = CENARIOS[novo].config;
      desenhar();
    }

    raiz.querySelectorAll<HTMLButtonElement>("[data-cenario]").forEach((b) =>
      b.addEventListener("click", () => trocarCenario(b.dataset.cenario!)),
    );
    raiz.querySelectorAll<HTMLButtonElement>("[data-modo]").forEach((b) =>
      b.addEventListener("click", () => {
        modo = b.dataset.modo as "loss" | "acc";
        raiz.querySelectorAll<HTMLElement>("[data-modo]").forEach((o) =>
          o.setAttribute("aria-pressed", String(o === b)),
        );
        desenhar();
      }),
    );
    slider.addEventListener("input", () => {
      parar();
      ate = parseInt(slider.value, 10);
      desenhar();
    });
    play.addEventListener("click", () => {
      if (animacao !== null) return parar();
      const E = CENARIOS[cenario].hist.length;
      if (ate >= E) ate = 1; // recomeça do zero se já estava no fim
      slider.value = String(ate);
      desenhar();
      play.textContent = "❚❚ Pausar";
      play.setAttribute("aria-label", "Pausar a animação");
      animacao = window.setInterval(() => {
        if (ate >= E) return parar();
        ate += 1;
        slider.value = String(ate);
        desenhar();
      }, E > 30 ? 90 : 140);
    });

    function ajustarTela() {
      W = Math.round(svg!.clientWidth);
      if (!W) return;
      const cheia = !!document.fullscreenElement && document.fullscreenElement.contains(svg!);
      H = cheia
        ? Math.min(Math.max(window.innerHeight - 420, 300), 640)
        : W >= 560
          ? Math.round(Math.min(Math.max(W * 0.42, 280), 400))
          : Math.round(Math.min(Math.max(W * 0.9, 300), 380));
      desenhar();
    }
    new ResizeObserver(() => {
      const l = Math.round(caixa.clientWidth);
      if (l === ultimaLargura) return;
      ultimaLargura = l;
      ajustarTela();
    }).observe(caixa);
    document.addEventListener("fullscreenchange", () => { ultimaLargura = -1; ajustarTela(); });

    trocarCenario("base");
    ajustarTela();
  });
</script>
