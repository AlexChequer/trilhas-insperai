---
// Aula 7 · As curvas de treino e validação na base de churn de telecom, epoch a
// epoch. O controle principal é o cenário (o treino-base em 50 epochs, treinou
// pouco, overfitting, bom); os secundários são trocar loss por acurácia e o
// slider "até o epoch N", que revela as curvas como elas apareceriam durante o
// treino. A tarefa é achar o ponto em que a validação para de acompanhar o
// treino — o marcador da menor loss de validação e a faixa entre as duas curvas
// estão ali para isso.
//
// Os números são reais: históricos de PyTorch (CPU) da base IBM Telco (7.032
// clientes, 46 entradas, 4.500 de treino e 1.250 de validação, 26,6% cancelaram),
// do arquivo aula-07/dados/churn.json da pasta da trilha, embutidos com 4 casas.
// Nada é simulado no navegador. Os cenários usam as mesmas chaves do deck da
// aula (demos/curvas.js): base, sub_taxa, l2_0 e l2_0.01. A base é de churn
// para a viz não adiantar números do desafio do Projeto 1.
//
// O gráfico é SVG (e não canvas, como as outras viz) porque assim as cores saem
// direto das variáveis do sistema de design, pelo CSS. Os elementos são criados
// em JS, então todo estilo deles vai em :global().
---

<div class="viz-curvas" data-viz="curvas">
  <div class="curvas-cenarios" role="group" aria-label="Cenário">
    <button class="curvas-opcao" type="button" data-cenario="base" aria-pressed="true">Treino-base · 50 epochs</button>
    <button class="curvas-opcao" type="button" data-cenario="under" aria-pressed="false">Treinou pouco</button>
    <button class="curvas-opcao" type="button" data-cenario="over" aria-pressed="false">Overfitting</button>
    <button class="curvas-opcao" type="button" data-cenario="bom" aria-pressed="false">Bom</button>
  </div>
  <p class="curvas-config" data-config>—</p>

  <div class="viz-grafico-caixa curvas-caixa">
    <svg class="curvas-svg" data-svg role="img" aria-label="Curvas de treino e validação por epoch"></svg>
    <div class="viz-legenda curvas-legenda">
      <span><i class="curvas-cor-treino"></i> treino</span>
      <span><i class="curvas-cor-val"></i> validação</span>
      <span><i class="curvas-cor-faixa"></i> distância entre as duas</span>
    </div>
  </div>

  <div class="curvas-controles">
    <div class="curvas-modos" role="group" aria-label="O que o eixo vertical mostra">
      <button class="curvas-opcao" type="button" data-modo="loss" aria-pressed="true">Loss</button>
      <button class="curvas-opcao" type="button" data-modo="acc" aria-pressed="false">Acurácia</button>
    </div>
    <div class="slider-campo curvas-slider">
      <label>Até o epoch <span class="valor" data-epoch-val>—</span></label>
      <input type="range" data-epoch min="1" max="50" step="1" value="50" aria-label="Até o epoch" />
    </div>
    <button class="curvas-opcao curvas-play" type="button" data-play aria-label="Animar epoch a epoch">▶ Animar</button>
  </div>

  <div class="curvas-abaixo">
    <div class="stat stat-destaque">
      <p class="stat-rotulo">Diagnóstico</p>
      <p class="stat-valor" data-diag>—</p>
      <span class="stat-unidade" data-diag-frase>—</span>
    </div>

    <div class="stat">
      <p class="stat-rotulo" data-placar-titulo>No epoch —</p>
      <ul class="curvas-placar">
        <li><i class="curvas-cor-treino"></i> acurácia de treino <b data-acc-treino>—</b></li>
        <li><i class="curvas-cor-val"></i> acurácia de validação <b data-acc-val>—</b></li>
        <li class="curvas-dist">distância <b data-dist>—</b></li>
      </ul>
      <p class="stat-caminho" data-loss-linha>—</p>
    </div>
  </div>
</div>

<style>
  .viz-curvas {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .curvas-cenarios,
  .curvas-modos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .curvas-opcao {
    appearance: none;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 999px;
    border: 2px solid var(--borda);
    background: var(--superficie);
    color: var(--insper-azul-aco);
    cursor: pointer;
    min-height: 44px;
  }
  .curvas-opcao:hover {
    border-color: var(--insper-azul);
  }
  .curvas-opcao[aria-pressed="true"] {
    background: var(--insper-gradiente);
    border-color: transparent;
    color: #fff;
  }
  .curvas-opcao:focus-visible {
    outline: 3px solid var(--insper-azul);
    outline-offset: 2px;
  }
  .curvas-config {
    margin: -4px 0 0;
    font-size: 0.88rem;
    color: var(--texto-suave);
  }
  .curvas-caixa {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .curvas-svg {
    display: block;
    width: 100%;
    font-family: var(--fonte);
  }
  .curvas-legenda {
    padding: 0 6px 4px;
  }
  .curvas-cor-treino {
    background: var(--insper-azul);
  }
  .curvas-cor-val {
    background: var(--coral);
  }
  .curvas-legenda .curvas-cor-faixa {
    height: 12px;
    border-radius: 3px;
    background: var(--coral);
    opacity: 0.22;
  }
  .curvas-controles {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: center;
  }
  .curvas-play {
    min-width: 116px;
  }
  .curvas-abaixo {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 12px;
    align-items: start;
  }
  .curvas-abaixo .stat-destaque .stat-valor {
    font-size: clamp(1.4rem, 3vw, 1.8rem);
  }
  .curvas-abaixo .stat-destaque .stat-unidade {
    display: block;
    margin-top: 6px;
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .curvas-placar {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.92rem;
    color: var(--texto-suave);
  }
  .curvas-placar li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .curvas-placar i {
    width: 20px;
    height: 4px;
    border-radius: 999px;
    flex: none;
  }
  .curvas-placar b {
    margin-left: auto;
    font-family: var(--fonte-dados);
    font-size: 1.05rem;
    color: var(--insper-azul-aco);
  }
  .curvas-dist {
    padding-top: 8px;
    border-top: 1px solid var(--borda);
  }

  /* ---- elementos do gráfico, criados em JS: tudo em :global() ---- */
  .curvas-svg :global(.g-grade) {
    stroke: var(--borda);
    stroke-width: 1;
  }
  .curvas-svg :global(.g-moldura) {
    fill: none;
    stroke: var(--borda);
    stroke-width: 1.5;
  }
  .curvas-svg :global(.g-eixo-txt) {
    fill: var(--texto-suave);
    font-size: 12px;
    font-weight: 600;
    font-family: var(--fonte-dados);
  }
  .curvas-svg :global(.g-eixo-nome) {
    fill: var(--texto-suave);
    font-size: 12px;
    font-weight: 600;
  }
  .curvas-svg :global(.g-faixa) {
    fill: var(--coral);
    opacity: 0.16;
  }
  .curvas-svg :global(.g-linha) {
    fill: none;
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .curvas-svg :global(.g-treino) {
    stroke: var(--insper-azul);
  }
  .curvas-svg :global(.g-val) {
    stroke: var(--coral);
  }
  .curvas-svg :global(.g-ponto-treino) {
    fill: var(--insper-azul);
    stroke: var(--superficie);
    stroke-width: 2.5;
  }
  .curvas-svg :global(.g-ponto-val) {
    fill: var(--coral);
    stroke: var(--superficie);
    stroke-width: 2.5;
  }
  .curvas-svg :global(.g-regua) {
    stroke: var(--insper-azul-aco);
    stroke-width: 2;
  }
  .curvas-svg :global(.g-regua-txt) {
    fill: var(--insper-azul-aco);
    font-size: 13px;
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--superficie);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .curvas-svg :global(.g-minimo-linha) {
    stroke: var(--insper-roxo);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
    opacity: 0.7;
  }
  .curvas-svg :global(.g-minimo-ponto) {
    fill: var(--superficie);
    stroke: var(--insper-roxo);
    stroke-width: 3;
  }
  .curvas-svg :global(.g-minimo-txt) {
    fill: var(--insper-roxo);
    font-size: 13px;
    font-weight: 700;
    paint-order: stroke;
    stroke: var(--superficie);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  @media (max-width: 760px) {
    .curvas-controles {
      grid-template-columns: 1fr auto;
    }
    .curvas-slider {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .curvas-abaixo {
      grid-template-columns: 1fr;
    }
  }
</style>

