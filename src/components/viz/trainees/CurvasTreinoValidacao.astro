    gap: 14px;
  }
  .curvas-cenarios,
  .curvas-modos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .curvas-opcao {
    appearance: none;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 10px 16px;
    border-radius: 999px;
    border: 2px solid var(--borda);
