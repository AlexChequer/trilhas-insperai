  }
  .curvas-opcao[aria-pressed="true"] {
    background: var(--insper-gradiente);
    border-color: transparent;
    color: #fff;
  }
  .curvas-opcao:focus-visible {
    outline: 3px solid var(--insper-azul);
    outline-offset: 2px;
  }
  .curvas-config {
    margin: -4px 0 0;
    font-size: 0.88rem;
    color: var(--texto-suave);
  }
  .curvas-caixa {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .curvas-svg {
    display: block;
    width: 100%;
    font-family: var(--fonte);
  }
  .curvas-legenda {
    padding: 0 6px 4px;
  }
  .curvas-cor-treino {
    background: var(--insper-azul);
  }
  .curvas-cor-val {
