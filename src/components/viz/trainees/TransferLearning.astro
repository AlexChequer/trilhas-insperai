---
// Aula 10 · Transfer learning. Um controle: quantas camadas ficam congeladas.
// O que se vê: quantos parâmetros sobram para treinar, quantas imagens isso
// exige, e o aviso de que descongelar tudo com learning rate alto destrói o que
// a rede pré-treinada já sabia — que é o erro comum da aula.
//
// Os números de parâmetros por bloco são os de uma VGG-16 (arquitetura pública,
// contagem verificável). A "acurácia esperada" é uma faixa ilustrativa, não
// medição — a página diz isso.
---

<div class="viz-transfer" data-viz="transfer">
  <div class="transfer-blocos" data-blocos></div>

  <div class="stat">
    <div class="slider-campo">
      <label>Congelar até <span class="valor" data-congelado-val>—</span></label>
      <input type="range" data-congelado min="0" max="5" step="1" value="4" />
    </div>
    <p class="stat-caminho">Da esquerda para a direita: bordas e cores → texturas → partes → objetos → a sua cabeça de classificação.</p>
  </div>

  <div class="transfer-grade">
    <div class="stat stat-destaque">
      <p class="stat-rotulo">Parâmetros a treinar</p>
      <p class="stat-valor" data-treinaveis>—</p>
      <span class="stat-unidade" data-fracao>—</span>
    </div>

    <div class="stat">
      <p class="stat-rotulo">O que isso implica</p>
      <p class="transfer-nota" data-implica>—</p>
    </div>
  </div>

  <p class="stat-caminho" data-aviso></p>
</div>

<style>
  .viz-transfer {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .transfer-blocos {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
  }
  .transfer-blocos :global(.tb) {
    border-radius: 10px;
    border: 2px solid var(--borda);
    background: var(--superficie);
    padding: 10px 8px;
    text-align: center;
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .transfer-blocos :global(.tb.congelado) {
    background: #eef4fb;
    border-color: #bcd3ea;
  }
  .transfer-blocos :global(.tb.treinando) {
    background: rgba(124, 58, 237, 0.1);
    border-color: var(--insper-roxo);
  }
  .transfer-blocos :global(.tb-nome) {
    display: block;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--insper-azul-aco);
    line-height: 1.25;
  }
  .transfer-blocos :global(.tb-detecta) {
    display: block;
    font-size: 0.68rem;
    color: var(--texto-suave);
    margin-top: 4px;
    line-height: 1.3;
  }
  .transfer-blocos :global(.tb-estado) {
    display: block;
    margin-top: 6px;
    font-size: 0.68rem;
    font-weight: 700;
  }
  .transfer-blocos :global(.tb.congelado .tb-estado) {
    color: #4b7db5;
  }
  .transfer-blocos :global(.tb.treinando .tb-estado) {
    color: var(--insper-roxo);
  }
  .transfer-grade {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 12px;
    align-items: start;
  }
  .transfer-nota {
    margin: 8px 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--texto-suave);
  }
  .transfer-nota :global(b) {
    color: var(--insper-azul-aco);
  }
  @media (max-width: 700px) {
    .transfer-blocos {
      grid-template-columns: repeat(3, 1fr);
    }
    .transfer-grade {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-viz="transfer"]').forEach((raiz) => {
    const el = (sel: string) => raiz.querySelector<HTMLElement>(`[data-${sel}]`)!;
    const slider = raiz.querySelector<HTMLInputElement>("[data-congelado]")!;

    // Contagem de parâmetros por bloco convolucional da VGG-16, mais uma cabeça
    // de classificação nova (a parte que é sua).
    const BLOCOS = [
      { nome: "bloco 1", detecta: "bordas e cores", params: 38_720 },
      { nome: "bloco 2", detecta: "cantos e curvas", params: 221_440 },
      { nome: "bloco 3", detecta: "texturas", params: 1_475_328 },
      { nome: "bloco 4", detecta: "partes de objeto", params: 5_899_776 },
      { nome: "bloco 5", detecta: "objetos inteiros", params: 7_079_424 },
      { nome: "sua cabeça", detecta: "as suas classes", params: 262_400 },
    ];
    const TOTAL = BLOCOS.reduce((s, b) => s + b.params, 0);
    const milhar = (v: number) => v.toLocaleString("pt-BR");

    BLOCOS.forEach((b) => {
      const div = document.createElement("div");
      div.className = "tb";
      div.innerHTML =
        `<span class="tb-nome">${b.nome}</span>` +
        `<span class="tb-detecta">${b.detecta}</span>` +
        `<span class="tb-estado"></span>`;
      el("blocos").appendChild(div);
    });

    function atualizar() {
      const congelados = parseInt(slider.value, 10); // quantos blocos ficam congelados
      const caixas = el("blocos").querySelectorAll<HTMLElement>(".tb");
      let treinaveis = 0;
      BLOCOS.forEach((b, i) => {
        const congelado = i < congelados;
        caixas[i].classList.toggle("congelado", congelado);
        caixas[i].classList.toggle("treinando", !congelado);
        caixas[i].querySelector(".tb-estado")!.textContent = congelado ? "congelado" : "treinando";
        if (!congelado) treinaveis += b.params;
      });

      const fracao = treinaveis / TOTAL;
      el("congelado-val").textContent =
        congelados === 0 ? "nada" : congelados === 6 ? "tudo" : `${congelados} ${congelados === 1 ? "bloco" : "blocos"}`;
      el("treinaveis").textContent = milhar(treinaveis);
      el("fracao").textContent = `${(fracao * 100).toFixed(1)}% dos ${milhar(TOTAL)} da rede inteira`;

      if (congelados >= 5) {
        el("implica").innerHTML =
          "Só a sua cabeça de classificação treina. É o <b>uso clássico</b> do transfer learning: funciona com <b>centenas</b> de imagens, treina em minutos numa máquina comum, e é sempre por aqui que se começa.";
        el("aviso").innerHTML =
          "As camadas congeladas viram um extrator de características fixo: você passa suas imagens por elas uma vez, guarda o resultado, e treina só o final em cima disso. Rápido e barato.";
      } else if (congelados >= 2) {
        el("implica").innerHTML =
          "<b>Fine-tuning parcial</b>: os blocos do fim se adaptam ao seu domínio, e os do começo — que aprenderam borda e cor — ficam como estão. É o passo seguinte quando só treinar a cabeça não bastou.";
        el("aviso").innerHTML =
          "Aqui o learning rate importa muito: use um valor <strong>bem menor</strong> que o de um treino do zero (uma ou duas ordens de grandeza). O objetivo é ajustar o que a rede já sabe, não reescrever.";
      } else {
        el("implica").innerHTML =
          "Quase tudo treinando. Você está praticamente <b>treinando do zero</b>, e só aproveitando a inicialização — o que exige <b>muitos dados</b> e muito tempo de GPU.";
        el("aviso").innerHTML =
          "<strong>Cuidado.</strong> Descongelar tudo e treinar com learning rate alto <strong>destrói</strong> o que a rede aprendeu em milhões de imagens: os primeiros gradientes, vindos de um dataset pequeno, sobrescrevem detectores de borda que levaram semanas de GPU para se formar. Se for descongelar, desça o learning rate junto.";
      }
    }

    slider.addEventListener("input", atualizar);
    atualizar();
  });
</script>
