---
// Aula 7 · Dropout. Um controle: a taxa. O slider percorre a história inteira —
// em 0 a rede decora (gap grande entre treino e validação), em 0,15 o gap quase
// some, e em 0,45 o dropout é tanto que a rede não aprende mais. É o mesmo
// formato de três cenários do slider de complexidade, agora com outro remédio.
//
// A rede do desenho é a MESMA que gera as curvas: 1 → 12 → 12 → 1, treinada de
// verdade aqui no navegador com Adam. Os neurônios apagados no diagrama são um
// sorteio novo, como acontece a cada passagem durante o treino.
---

<div class="viz-dropout" data-viz="dropout">
  <div class="dropout-topo">
    <div class="viz-grafico-caixa">
      <canvas class="viz-canvas"></canvas>
    </div>

    <aside class="viz-painel">
      <div class="stat stat-destaque">
        <p class="stat-rotulo">Distância treino → validação</p>
        <p class="stat-valor" data-gap>—</p>
        <span class="stat-unidade" data-gap-nota>—</span>
      </div>

      <div class="stat">
        <div class="slider-campo">
          <label>Taxa de dropout <span class="valor" data-taxa-val>—</span></label>
          <input type="range" data-taxa min="0" max="4" step="1" value="0" />
        </div>
        <p class="stat-caminho" data-desligados>—</p>
      </div>

      <div class="stat">
        <p class="stat-rotulo">Erro no fim</p>
        <ul class="dropout-placar">
          <li><i style="background: #2563eb"></i> treino <b data-err-treino>—</b></li>
          <li><i style="background: #f4603e"></i> validação <b data-err-val>—</b></li>
        </ul>
        <p class="dropout-parada" data-parada>—</p>
      </div>
    </aside>
  </div>

  <p class="stat-caminho dropout-nota" data-nota></p>
</div>

<style>
  .viz-dropout {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* Canvas em largura cheia: numa coluna estreita a rede e as curvas ficavam
     empilhadas e o rótulo do early stopping não cabia. */
  .dropout-topo {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .dropout-topo .viz-painel {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1.9fr;
    gap: 12px;
    align-items: start;
  }
  /* sem isto os cards crescem até caber o conteúdo e estouram a caixa */
  .dropout-topo .viz-painel > * {
    min-width: 0;
  }
  .dropout-topo .stat-destaque .stat-valor {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .dropout-placar {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.92rem;
    color: var(--texto-suave);
  }
  .dropout-placar li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dropout-placar i {
    width: 20px;
    height: 4px;
    border-radius: 999px;
    flex: none;
  }
  .dropout-placar b {
    margin-left: auto;
    font-family: var(--fonte-dados);
    font-size: 1.05rem;
    color: var(--insper-azul-aco);
  }
  .dropout-nota {
    margin: 0;
  }
  .dropout-parada {
    margin: 10px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--borda);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--texto-suave);
  }
  .dropout-parada strong {
    color: var(--verde);
  }
  @media (max-width: 760px) {
    .dropout-topo .viz-painel {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-viz="dropout"]').forEach((raiz) => {
    const canvas = raiz.querySelector<HTMLCanvasElement>(".viz-canvas");
    const caixa = canvas?.parentElement;
    if (!canvas || !caixa) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const el = (sel: string) => raiz.querySelector<HTMLElement>(`[data-${sel}]`)!;
    const slider = raiz.querySelector<HTMLInputElement>("[data-taxa]")!;

    const TAXAS = [0, 0.05, 0.15, 0.3, 0.45];
    const S = [1, 12, 12, 1];
    const EPOCHS = 900, LR = 0.02, AMOSTRAGEM = 10;
    const COR = {
      treino: "#2563eb", validacao: "#f4603e", grade: "#eef2f8",
      eixo: "#c7d2e0", suave: "#8b95a5", azulAco: "#294a6b", apagado: "#dbe3ef",
      parada: "#16a34a",
    };

    function rng(semente: number) {
      let s = semente;
      return () => { s = (s + 0x6d2b79f5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
    }
    function normal(R: () => number) {
      let u = 0, v = 0;
      while (u === 0) u = R();
      while (v === 0) v = R();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }
    const verdade = (x: number) => Math.sin(x * 2.4) * 0.8 + x * 0.2;
    function conjunto(n: number, semente: number, ruido: number) {
      const R = rng(semente);
      return Array.from({ length: n }, (_, i) => {
        const x = -1 + (2 * (i + 0.5)) / n;
        return { x, y: verdade(x) + normal(R) * ruido };
      });
    }
    const TREINO = conjunto(14, 3, 0.22);
    const VALIDACAO = conjunto(160, 555, 0.22);

    function treinar(taxa: number) {
      const R = rng(4);
      const W = S.slice(0, 3).map((_, l) =>
        Array.from({ length: S[l + 1] }, () => Array.from({ length: S[l] }, () => normal(R) * Math.sqrt(2 / S[l]))),
      );
      const b = S.slice(0, 3).map((_, l) => new Array(S[l + 1]).fill(0));
      const mW = W.map((m) => m.map((r) => r.map(() => 0))), vW = W.map((m) => m.map((r) => r.map(() => 0)));
      const mb = b.map((r) => r.map(() => 0)), vb = b.map((r) => r.map(() => 0));
      const B1 = 0.9, B2 = 0.999, EPS = 1e-8;
      let t = 0;
      const Rd = rng(91);

      const passar = (x: number, mascaras: number[][] | null) => {
        const a: number[][] = [[x]];
        for (let l = 0; l < 3; l++) {
          const z = W[l].map((linha, i) => linha.reduce((s, w, j) => s + w * a[l][j], 0) + b[l][i]);
          let saida = l < 2 ? z.map(Math.tanh) : z;
          if (l < 2 && mascaras) saida = saida.map((v, i) => v * mascaras[l][i]);
          a.push(saida);
        }
        return a;
      };
      const erroDe = (D: { x: number; y: number }[]) =>
        Math.sqrt(D.reduce((s, d) => s + (passar(d.x, null)[3][0] - d.y) ** 2, 0) / D.length);

      const historico: { ep: number; tr: number; va: number }[] = [];
      for (let ep = 0; ep < EPOCHS; ep++) {
        const gW = W.map((m) => m.map((r) => r.map(() => 0)));
        const gb = b.map((r) => r.map(() => 0));
        for (const d of TREINO) {
          // inverted dropout: quem sobrevive é escalado por 1/(1−p), para a soma
          // manter a mesma ordem de grandeza com e sem dropout
          const mascaras = taxa > 0
            ? [0, 1].map((l) => Array.from({ length: S[l + 1] }, () => (Rd() < taxa ? 0 : 1 / (1 - taxa))))
            : null;
          const a = passar(d.x, mascaras);
          let delta = [(2 * (a[3][0] - d.y)) / TREINO.length];
          for (let l = 2; l >= 0; l--) {
            for (let i = 0; i < S[l + 1]; i++) {
              gb[l][i] += delta[i];
              for (let j = 0; j < S[l]; j++) gW[l][i][j] += delta[i] * a[l][j];
            }
            if (l > 0) {
              const proximo = new Array(S[l]).fill(0);
              for (let j = 0; j < S[l]; j++) {
                let s = 0;
                for (let i = 0; i < S[l + 1]; i++) s += W[l][i][j] * delta[i];
                proximo[j] = s * (1 - a[l][j] ** 2) * (mascaras ? mascaras[l - 1][j] : 1);
              }
              delta = proximo;
            }
          }
        }
        t++;
        for (let l = 0; l < 3; l++) {
          for (let i = 0; i < S[l + 1]; i++) {
            mb[l][i] = B1 * mb[l][i] + (1 - B1) * gb[l][i];
            vb[l][i] = B2 * vb[l][i] + (1 - B2) * gb[l][i] ** 2;
            b[l][i] -= (LR * (mb[l][i] / (1 - B1 ** t))) / (Math.sqrt(vb[l][i] / (1 - B2 ** t)) + EPS);
            for (let j = 0; j < S[l]; j++) {
              mW[l][i][j] = B1 * mW[l][i][j] + (1 - B1) * gW[l][i][j];
              vW[l][i][j] = B2 * vW[l][i][j] + (1 - B2) * gW[l][i][j] ** 2;
              W[l][i][j] -= (LR * (mW[l][i][j] / (1 - B1 ** t))) / (Math.sqrt(vW[l][i][j] / (1 - B2 ** t)) + EPS);
            }
          }
        }
        if (ep % AMOSTRAGEM === 0 || ep === EPOCHS - 1) {
          historico.push({ ep, tr: erroDe(TREINO), va: erroDe(VALIDACAO) });
        }
      }
      return historico;
    }

    // Treina as cinco taxas de uma vez (a rede é pequena, custa pouco) para
    // saber qual delas a validação elege — é ela que o painel chama de "o ponto".
    const HISTORICOS = TAXAS.map((taxa) => treinar(taxa));
    const historicoDe = (taxa: number) => HISTORICOS[TAXAS.indexOf(taxa)];
    const fimDe = (i: number) => HISTORICOS[i][HISTORICOS[i].length - 1];
    const MELHOR = HISTORICOS.reduce((m, _, i) => (fimDe(i).va < fimDe(m).va ? i : m), 0);

    let indice = 0;
    let mascara: boolean[][] = [[], []];
    let W = 0, H = 0, ultimaLargura = -1;
    const sorteio = rng(2024);
    const num = (v: number, casas: number) => v.toFixed(casas).replace(".", ",");
    const fonte = () => getComputedStyle(document.body).fontFamily;

    function sortearMascara() {
      const taxa = TAXAS[indice];
      mascara = [0, 1].map((l) => Array.from({ length: S[l + 1] }, () => sorteio() < taxa));
    }

    const ERRO_MAX = 0.85;
    const MARGEM = { topo: 26, dir: 14, base: 40, esq: 48 };

    function desenhar() {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      const taxa = TAXAS[indice];
      const historico = historicoDe(taxa);
      // o epoch em que a validação foi menor: é onde o early stopping pararia
      const melhorEpoca = historico.reduce((m, h) => (h.va < m.va ? h : m), historico[0]);

      // Em tela larga a rede fica à esquerda e as curvas à direita; em tela
      // estreita elas empilham, com a rede em cima.
      const ladoALado = W >= 560;
      const larguraRede = ladoALado ? Math.round(W * 0.38) : W;
      const alturaRede = ladoALado ? H : Math.round(H * 0.42);
      const p = ladoALado
        ? {
            x: larguraRede + MARGEM.esq, y: MARGEM.topo,
            w: W - larguraRede - MARGEM.esq - MARGEM.dir, h: H - MARGEM.topo - MARGEM.base,
          }
        : {
            x: MARGEM.esq, y: alturaRede + MARGEM.topo,
            w: W - MARGEM.esq - MARGEM.dir, h: H - alturaRede - MARGEM.topo - MARGEM.base,
          };

      // ---------- a rede, com os neurônios sorteados apagados ----------
      {
        const M = { esq: 34, dir: 34, topo: 22, base: 12 };
        const largura = larguraRede - M.esq - M.dir, altura = alturaRede - M.topo - M.base;
        const pos = S.map((n, l) => {
          const x = M.esq + (largura * l) / (S.length - 1);
          const passo = Math.min(altura / Math.max(n, 1), 18);
          const y0 = M.topo + altura / 2 - (passo * (n - 1)) / 2;
          return Array.from({ length: n }, (_, i) => ({ x, y: y0 + passo * i }));
        });
        const vivo = (l: number, i: number) => (l === 1 || l === 2 ? !mascara[l - 1][i] : true);

        for (let l = 0; l < 3; l++) {
          for (let i = 0; i < S[l + 1]; i++) {
            for (let j = 0; j < S[l]; j++) {
              const ativo = vivo(l, j) && vivo(l + 1, i);
              ctx.strokeStyle = ativo ? "rgba(37,99,235,0.22)" : COR.apagado;
              ctx.lineWidth = ativo ? 1.1 : 0.6;
              ctx.beginPath();
              ctx.moveTo(pos[l][j].x, pos[l][j].y);
              ctx.lineTo(pos[l + 1][i].x, pos[l + 1][i].y);
              ctx.stroke();
            }
          }
        }
        pos.forEach((camada, l) => {
          camada.forEach((q, i) => {
            const ativo = vivo(l, i);
            ctx.beginPath(); ctx.arc(q.x, q.y, 6, 0, Math.PI * 2);
            ctx.fillStyle = ativo ? "rgba(41,74,107,0.5)" : "#fff";
            ctx.fill();
            ctx.lineWidth = 2;
            ctx.strokeStyle = ativo ? COR.azulAco : COR.apagado;
            ctx.stroke();
            if (!ativo) {
              ctx.strokeStyle = COR.apagado; ctx.lineWidth = 1.6;
              ctx.beginPath();
              ctx.moveTo(q.x - 3.5, q.y - 3.5); ctx.lineTo(q.x + 3.5, q.y + 3.5);
              ctx.moveTo(q.x + 3.5, q.y - 3.5); ctx.lineTo(q.x - 3.5, q.y + 3.5);
              ctx.stroke();
            }
          });
        });
        const desligados = mascara[0].filter(Boolean).length + mascara[1].filter(Boolean).length;
        ctx.fillStyle = COR.azulAco; ctx.font = "700 13px " + fonte();
        ctx.textAlign = "left"; ctx.textBaseline = "top";
        ctx.fillText(taxa === 0 ? "a rede inteira, sempre" : `${desligados}/24 ocultos fora`, 6, 4);
      }

      // ---------- as curvas de treino e validação ----------
      const ultimo = historico[historico.length - 1];
      const gx = (ep: number) => p.x + (ep / EPOCHS) * p.w;
      const gy = (e: number) => p.y + (1 - Math.min(e, ERRO_MAX) / ERRO_MAX) * p.h;

      ctx.strokeStyle = COR.grade; ctx.lineWidth = 1;
      ctx.fillStyle = COR.suave; ctx.font = "600 12px " + fonte();
      ctx.textAlign = "right"; ctx.textBaseline = "middle";
      for (let e = 0; e <= ERRO_MAX + 0.001; e += 0.2) {
        const yy = gy(e);
        ctx.beginPath(); ctx.moveTo(p.x, yy); ctx.lineTo(p.x + p.w, yy); ctx.stroke();
        ctx.fillText(num(e, 1), p.x - 7, yy);
      }
      ctx.textAlign = "center"; ctx.textBaseline = "top";
      for (let ep = 0; ep <= EPOCHS; ep += 300) ctx.fillText(String(ep), gx(ep), p.y + p.h + 6);
      ctx.strokeStyle = COR.eixo; ctx.lineWidth = 1.5; ctx.strokeRect(p.x, p.y, p.w, p.h);

      ctx.save();
      ctx.beginPath(); ctx.rect(p.x, p.y, p.w, p.h); ctx.clip();
      // a faixa entre as duas curvas é o próprio gap
      ctx.fillStyle = "rgba(244,96,62,0.12)";
      ctx.beginPath();
      historico.forEach((h, i) => (i === 0 ? ctx.moveTo(gx(h.ep), gy(h.va)) : ctx.lineTo(gx(h.ep), gy(h.va))));
      for (let i = historico.length - 1; i >= 0; i--) ctx.lineTo(gx(historico[i].ep), gy(historico[i].tr));
      ctx.closePath(); ctx.fill();

      for (const [chave, cor] of [["tr", COR.treino], ["va", COR.validacao]] as const) {
        ctx.strokeStyle = cor; ctx.lineWidth = 3; ctx.lineJoin = "round";
        ctx.beginPath();
        historico.forEach((h, i) => {
          const y = gy((h as any)[chave]);
          i === 0 ? ctx.moveTo(gx(h.ep), y) : ctx.lineTo(gx(h.ep), y);
        });
        ctx.stroke();
      }

      // Early stopping: onde a validação atingiu o menor valor. Tudo o que vem
      // depois da linha é treino que continua melhorando o treino e piorando (ou
      // não melhorando) a validação — o modelo que interessa é o daquele momento.
      const xMelhor = gx(melhorEpoca.ep);
      ctx.setLineDash([6, 5]);
      ctx.strokeStyle = COR.parada; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(xMelhor, p.y); ctx.lineTo(xMelhor, p.y + p.h); ctx.stroke();
      ctx.setLineDash([]);
      // a região descartada pelo early stopping
      ctx.fillStyle = "rgba(41,74,107,0.05)";
      ctx.fillRect(xMelhor, p.y, p.x + p.w - xMelhor, p.h);
      ctx.beginPath(); ctx.arc(xMelhor, gy(melhorEpoca.va), 6, 0, Math.PI * 2);
      ctx.fillStyle = COR.parada; ctx.fill();
      ctx.lineWidth = 2.5; ctx.strokeStyle = "#fff"; ctx.stroke();

      ctx.fillStyle = COR.parada; ctx.font = "700 11px " + fonte();
      const aDireita = xMelhor < p.x + p.w * 0.6;
      const espaco = aDireita ? p.x + p.w - xMelhor : xMelhor - p.x;
      const rotulo = espaco > 160 ? "early stopping pararia aqui" : espaco > 90 ? "early stopping" : "parar aqui";
      ctx.textAlign = aDireita ? "left" : "right";
      ctx.textBaseline = "top";
      ctx.fillText(rotulo, xMelhor + (aDireita ? 8 : -8), p.y + 6);
      ctx.restore();

      ctx.fillStyle = COR.azulAco; ctx.font = "600 12px " + fonte();
      ctx.textAlign = "center"; ctx.textBaseline = "top";
      ctx.fillText("epochs", p.x + p.w / 2, p.y + p.h + 22);

      // ---------- painel ----------
      const folga = ultimo.va - ultimo.tr;
      el("taxa-val").textContent = taxa === 0 ? "desligado" : num(taxa, 2);
      el("gap").textContent = num(folga, 3);
      el("err-treino").textContent = num(ultimo.tr, 3);
      el("err-val").textContent = num(ultimo.va, 3);

      const desperdicio = ultimo.va - melhorEpoca.va;
      el("parada").innerHTML =
        desperdicio > 0.004
          ? `A linha verde é o <strong>early stopping</strong>: a validação atingiu o menor valor no epoch ` +
            `<strong>${melhorEpoca.ep}</strong> (${num(melhorEpoca.va, 3)}) e piorou até o fim. Guardando os pesos ` +
            `daquele momento em vez dos últimos, você levaria um modelo <strong>${num(desperdicio, 3)}</strong> melhor — ` +
            `de graça, só parando antes.`
          : `A linha verde é o <strong>early stopping</strong>: a validação chegou ao menor valor no epoch ` +
            `<strong>${melhorEpoca.ep}</strong> e não piorou de forma relevante depois. Aqui treinar até o fim não custou nada — ` +
            `mas você só sabe disso porque estava olhando a validação.`;
      el("desligados").innerHTML = taxa === 0
        ? "todos os 24 neurônios ocultos participam de todas as passagens."
        : `a cada passagem, cada neurônio oculto tem <strong>${Math.round(taxa * 100)}%</strong> de chance de ser desligado — e o sorteio é novo toda vez.`;

      if (taxa === 0) {
        el("gap-nota").textContent = "a faixa vermelha é o overfitting";
        el("nota").innerHTML = "Sem dropout, o erro de treino desce muito abaixo do de validação: a rede está <strong>decorando</strong> os 14 pontos, ruído incluído. A faixa entre as duas curvas é o que sobra de aprendizado falso. <strong>Suba a taxa</strong> e veja a faixa fechar.";
      } else if (indice === MELHOR) {
        el("gap-nota").textContent = "o menor erro de validação das cinco taxas";
        el("nota").innerHTML = `Aqui está o ponto. Desligar neurônios ao acaso impede a rede de depender de um caminho específico — ela é obrigada a espalhar o que aprendeu. Repare no negócio que foi feito: o erro de treino <strong>piorou</strong> (de ${num(fimDe(0).tr, 3)} para ${num(ultimo.tr, 3)}) e mesmo assim o de validação melhorou (de ${num(fimDe(0).va, 3)} para ${num(ultimo.va, 3)}). É exatamente isso que toda regularização propõe.`;
      } else if (ultimo.tr > 0.4) {
        el("gap-nota").textContent = "agora falta capacidade";
        el("nota").innerHTML = "Dropout demais. Com boa parte da rede fora a cada passagem, sobra pouca coisa para aprender o padrão — e os dois erros sobem juntos. Isto é <strong>underfitting</strong>: o mesmo diagnóstico do grau 0 no gráfico anterior, por um caminho diferente.";
      } else {
        el("gap-nota").textContent = "a faixa está encolhendo";
        el("nota").innerHTML = `A faixa entre treino e validação já diminuiu bastante. Mas a validação não está no melhor valor: quem manda é ela, e ela prefere a taxa <strong>${num(TAXAS[MELHOR], 2)}</strong>. Continue mexendo — e repare que, passando do ponto, tudo piora de novo.`;
      }
    }

    function trocar() {
      indice = parseInt(slider.value, 10);
      sortearMascara();
      desenhar();
    }
    slider.addEventListener("input", trocar);

    // um sorteio novo de tempos em tempos: é o que acontece a cada passagem do treino
    const semAnimacao = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!semAnimacao) {
      window.setInterval(() => {
        if (TAXAS[indice] === 0) return;
        sortearMascara();
        desenhar();
      }, 1100);
    }

    function ajustarTela() {
      if (!canvas || !ctx) return;
      const dpr = window.devicePixelRatio || 1;
      W = canvas.clientWidth;
      const cheia = !!document.fullscreenElement && document.fullscreenElement.contains(canvas);
      H = cheia
        ? Math.min(Math.max(window.innerHeight - 180, 380), 800)
        : W >= 560
          ? Math.round(Math.min(Math.max(W * 0.42, 260), 380))
          : Math.round(Math.min(Math.max(W * 1.25, 360), 560));
      canvas.style.height = H + "px";
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      desenhar();
    }
    new ResizeObserver(() => {
      const l = Math.round(caixa.clientWidth);
      if (l === ultimaLargura) return;
      ultimaLargura = l;
      ajustarTela();
    }).observe(caixa);
    document.addEventListener("fullscreenchange", () => { ultimaLargura = -1; ajustarTela(); });

    sortearMascara();
    ajustarTela();
  });
</script>
