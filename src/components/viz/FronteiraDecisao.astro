---
// Aula 3 · Fronteira de decisão num plano 2D. Com features polinomiais a fronteira
// deixa de ser reta e vira curva — separando dados que uma reta não separa.
---

<div class="viz-corpo" data-viz="fronteira">
  <div class="viz-grafico-caixa">
    <canvas class="viz-canvas"></canvas>
  </div>

  <aside class="viz-painel">
    <div class="stat stat-destaque">
      <p class="stat-rotulo">Acurácia</p>
      <p class="stat-valor" data-acc>—</p>
      <span class="stat-unidade" data-modo>—</span>
    </div>

    <div class="viz-legenda">
      <span><i style="background: var(--ciano)"></i> classe A</span>
      <span><i style="background: var(--coral)"></i> classe B</span>
    </div>

    <div class="viz-controles">
      <button class="btn" type="button" data-toggle>Ligar features polinomiais</button>
    </div>

    <p class="stat-caminho" data-nota></p>
  </aside>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-viz="fronteira"]').forEach((raiz) => {
    const canvas = raiz.querySelector<HTMLCanvasElement>(".viz-canvas");
    const caixa = canvas?.parentElement;
    if (!canvas || !caixa) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const elAcc = raiz.querySelector<HTMLElement>("[data-acc]")!;
    const elModo = raiz.querySelector<HTMLElement>("[data-modo]")!;
    const elNota = raiz.querySelector<HTMLElement>("[data-nota]")!;
    const btn = raiz.querySelector<HTMLButtonElement>("[data-toggle]")!;

    // dados: classe A no centro, classe B num anel em volta (uma reta não separa)
    function rng(seed: number) {
      return () => { seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
    }
    const rand = rng(7);
    const DADOS: { x1: number; x2: number; y: number }[] = [];
    for (let i = 0; i < 22; i++) { const r = 0.05 + rand() * 0.36, a = rand() * Math.PI * 2; DADOS.push({ x1: r * Math.cos(a), x2: r * Math.sin(a), y: 0 }); }
    for (let i = 0; i < 28; i++) { const r = 0.6 + rand() * 0.34, a = rand() * Math.PI * 2; DADOS.push({ x1: r * Math.cos(a), x2: r * Math.sin(a), y: 1 }); }

    const featLin = (a: number, b: number) => [a, b];
    const featPoly = (a: number, b: number) => [a, b, a * a, b * b, a * b];

    function ajusta(feat: (a: number, b: number) => number[]) {
      const F = DADOS.map((d) => feat(d.x1, d.x2));
      const dim = F[0].length;
      const media = new Array(dim).fill(0), desvio = new Array(dim).fill(0);
      for (const f of F) for (let j = 0; j < dim; j++) media[j] += f[j];
      for (let j = 0; j < dim; j++) media[j] /= F.length;
      for (const f of F) for (let j = 0; j < dim; j++) desvio[j] += (f[j] - media[j]) ** 2;
      for (let j = 0; j < dim; j++) desvio[j] = Math.sqrt(desvio[j] / F.length) || 1;
      const Z = F.map((f) => f.map((v, j) => (v - media[j]) / desvio[j]));
      const w = new Array(dim).fill(0); let b = 0;
      for (let it = 0; it < 800; it++) {
        const gw = new Array(dim).fill(0); let gb = 0;
        for (let i = 0; i < Z.length; i++) {
          let s = b; for (let j = 0; j < dim; j++) s += w[j] * Z[i][j];
          const p = 1 / (1 + Math.exp(-s)); const e = p - DADOS[i].y;
          for (let j = 0; j < dim; j++) gw[j] += e * Z[i][j]; gb += e;
        }
        for (let j = 0; j < dim; j++) w[j] -= (0.5 * gw[j]) / Z.length; b -= (0.5 * gb) / Z.length;
      }
      const prob = (a: number, bb: number) => {
        const f = feat(a, bb); let s = b;
        for (let j = 0; j < dim; j++) s += w[j] * (f[j] - media[j]) / desvio[j];
        return 1 / (1 + Math.exp(-s));
      };
      const acc = DADOS.filter((d) => (prob(d.x1, d.x2) >= 0.5 ? 1 : 0) === d.y).length / DADOS.length;
      return { prob, acc };
    }
    const FIT = { lin: ajusta(featLin), poly: ajusta(featPoly) };

    let polinomial = false;
    let W = 0, H = 0, ultimaLargura = -1;
    const VISTA = 1.12;
    const MARGEM = { topo: 14, dir: 14, base: 14, esq: 14 };
    const COR = { ciano: "#0ea5e9", coral: "#f4603e", azulAco: "#294a6b" };

    function geo() {
      const p = { x: MARGEM.esq, y: MARGEM.topo, w: W - MARGEM.esq - MARGEM.dir, h: H - MARGEM.topo - MARGEM.base };
      const s = Math.min(p.w, p.h) / 2 / VISTA;
      return { p, s, cx: p.x + p.w / 2, cy: p.y + p.h / 2 };
    }

    function desenhar() {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      const fit = polinomial ? FIT.poly : FIT.lin;
      const { p, s, cx, cy } = geo();
      const wx = (a: number) => cx + a * s, wy = (b: number) => cy - b * s;

      ctx.save();
      ctx.beginPath(); ctx.rect(p.x, p.y, p.w, p.h); ctx.clip();

      // fundo colorido pela previsão (heatmap das regiões)
      const passo = 8;
      for (let X = p.x; X < p.x + p.w; X += passo) {
        for (let Y = p.y; Y < p.y + p.h; Y += passo) {
          const a = (X + passo / 2 - cx) / s, b = -(Y + passo / 2 - cy) / s;
          const pr = fit.prob(a, b);
          // mistura ciano (0) → coral (1), suave
          const r = Math.round(14 + pr * (244 - 14));
          const g = Math.round(165 + pr * (96 - 165));
          const bl = Math.round(233 + pr * (62 - 233));
          ctx.fillStyle = `rgba(${r},${g},${bl},0.2)`;
          ctx.fillRect(X, Y, passo, passo);
        }
      }

      // A fronteira de decisão em si: o lugar onde a probabilidade cruza 0,5.
      // Varremos o plano em coluna e em linha procurando a troca de lado —
      // as duas passadas garantem contorno contínuo tanto onde ele é íngreme
      // quanto onde é deitado. Serve igual para a reta e para a curva.
      const PASSO_CONTORNO = 3;
      const RAIO_CONTORNO = 2.2;
      const acima = (X: number, Y: number) => fit.prob((X - cx) / s, -(Y - cy) / s) >= 0.5;
      const marca = (X: number, Y: number) => {
        ctx.beginPath(); ctx.arc(X, Y, RAIO_CONTORNO, 0, Math.PI * 2); ctx.fill();
      };
      ctx.fillStyle = COR.azulAco;
      for (let X = p.x; X <= p.x + p.w; X += PASSO_CONTORNO) {
        let anterior = acima(X, p.y);
        for (let Y = p.y + PASSO_CONTORNO; Y <= p.y + p.h; Y += PASSO_CONTORNO) {
          const atual = acima(X, Y);
          if (atual !== anterior) marca(X, Y - PASSO_CONTORNO / 2);
          anterior = atual;
        }
      }
      for (let Y = p.y; Y <= p.y + p.h; Y += PASSO_CONTORNO) {
        let anterior = acima(p.x, Y);
        for (let X = p.x + PASSO_CONTORNO; X <= p.x + p.w; X += PASSO_CONTORNO) {
          const atual = acima(X, Y);
          if (atual !== anterior) marca(X - PASSO_CONTORNO / 2, Y);
          anterior = atual;
        }
      }

      // eixos
      ctx.strokeStyle = "rgba(41,74,107,0.12)"; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(p.x, cy); ctx.lineTo(p.x + p.w, cy); ctx.moveTo(cx, p.y); ctx.lineTo(cx, p.y + p.h); ctx.stroke();

      // pontos
      for (const d of DADOS) {
        ctx.beginPath(); ctx.arc(wx(d.x1), wy(d.x2), 6, 0, Math.PI * 2);
        ctx.fillStyle = d.y === 1 ? COR.coral : COR.ciano; ctx.fill();
        ctx.lineWidth = 2; ctx.strokeStyle = "#fff"; ctx.stroke();
      }
      ctx.restore();

      elAcc.textContent = Math.round(fit.acc * 100) + "%";
      elModo.textContent = polinomial ? "com features polinomiais" : "só features lineares";
      btn.textContent = polinomial ? "Desligar features polinomiais" : "Ligar features polinomiais";
      elNota.innerHTML = polinomial
        ? "A fronteira virou uma <strong>curva</strong> e separou os dois grupos."
        : "Uma <strong>reta</strong> não separa um grupo que está dentro do outro.";
    }

    btn.addEventListener("click", () => { polinomial = !polinomial; desenhar(); });

    function ajustar() {
      if (!canvas || !ctx) return;
      const dpr = window.devicePixelRatio || 1;
      W = canvas.clientWidth;
      const cheia = !!document.fullscreenElement && document.fullscreenElement.contains(canvas);
      H = cheia
        ? Math.min(Math.max(window.innerHeight - 150, 420), 820)
        : Math.round(Math.min(Math.max(W * 0.74, 320), 560));
      canvas.style.height = H + "px";
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      desenhar();
    }
    new ResizeObserver(() => {
      const l = Math.round(caixa.clientWidth);
      if (l === ultimaLargura) return;
      ultimaLargura = l;
      ajustar();
    }).observe(caixa);
    document.addEventListener("fullscreenchange", () => { ultimaLargura = -1; ajustar(); });

    ajustar();
  });
</script>
