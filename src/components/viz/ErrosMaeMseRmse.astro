---
// Aula 1 · Comparação MAE × MSE × RMSE com um outlier que liga/desliga.
// Lição: o MSE explode, o MAE quase não se move.
// O professor também pode clicar no gráfico e colocar os pontos que quiser.
---

<div class="viz-corpo" data-viz="erros">
  <div class="viz-grafico-caixa">
    <canvas class="viz-canvas"></canvas>
  </div>

  <aside class="viz-painel">
    <div class="stat" data-card="mae">
      <p class="stat-rotulo">MAE — erro absoluto</p>
      <p class="stat-valor"><span data-val>—</span> <span class="stat-unidade">R$ mil</span></p>
      <p class="stat-caminho" data-fator hidden></p>
    </div>
    <div class="stat" data-card="mse">
      <p class="stat-rotulo">MSE — erro ao quadrado</p>
      <p class="stat-valor"><span data-val>—</span> <span class="stat-unidade">(R$ mil)²</span></p>
      <p class="stat-caminho" data-fator hidden></p>
    </div>
    <div class="stat" data-card="rmse">
      <p class="stat-rotulo">RMSE — raiz do MSE</p>
      <p class="stat-valor"><span data-val>—</span> <span class="stat-unidade">R$ mil</span></p>
      <p class="stat-caminho" data-fator hidden></p>
    </div>

    <div class="viz-controles">
      <button class="btn" type="button" data-toggle>Adicionar outlier</button>
      <button class="btn btn-secundario" type="button" data-limpar disabled>Limpar pontos</button>
    </div>
  </aside>

  <p class="viz-dica viz-dica-larga">
    Clique no gráfico para colocar um ponto onde quiser — e clique em cima dele
    para tirar. A reta não se mexe: só os números mudam.
  </p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-viz="erros"]').forEach((raiz) => {
    const canvas = raiz.querySelector<HTMLCanvasElement>(".viz-canvas");
    const caixa = canvas?.parentElement;
    if (!canvas || !caixa) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const BASE: [number, number][] = [
      [45, 320], [60, 380], [75, 500], [90, 460], [110, 640], [125, 700],
      [140, 680], [160, 850], [175, 900], [195, 1010], [210, 980],
      [230, 1180], [250, 1220], [270, 1300],
    ];
    const ESPECIAL_X = 150;
    const ESPECIAL_NORMAL = 790; // em cima da tendência
    const ESPECIAL_OUTLIER = 1400; // bem longe
    const DOMINIO = { xMin: 20, xMax: 290, yMin: 0, yMax: 1500 };
    const MARGEM = { topo: 26, dir: 22, base: 56, esq: 74 };
    const RAIO_TOQUE = 16; // px: clicar dentro disso remove o ponto colocado

    const COR = {
      roxo: "#7c3aed", azul: "#2563eb", azulAco: "#294a6b",
      residuo: "#94a3b8", ponto: "#3730a3", outlier: "#f4603e",
      extra: "#0ea5e9", // pontos colocados na mão
      grade: "#eef2f8", eixo: "#c7d2e0", verde: "#16a34a", vermelho: "#dc2626",
    };
    const nf0 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 0 });
    const nf1 = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 1 });

    type Tipo = "base" | "especial" | "extra";
    interface Ponto { x: number; y: number; tipo: Tipo }

    // Reta fixa: mínimos quadrados sobre os pontos-base.
    // Nem o outlier nem os pontos colocados na mão movem a reta — é o ponto da lição.
    const RETA = (() => {
      const n = BASE.length;
      let sx = 0, sy = 0, sxy = 0, sxx = 0;
      for (const [x, y] of BASE) { sx += x; sy += y; sxy += x * y; sxx += x * x; }
      const w = (n * sxy - sx * sy) / (n * sxx - sx * sx);
      const b = (sy - w * sx) / n;
      return { w, b };
    })();
    const prever = (x: number) => RETA.w * x + RETA.b;

    let outlierLigado = false;
    let extras: { x: number; y: number }[] = [];
    let W = 0, H = 0, ultimaLargura = -1;

    function pontos(): Ponto[] {
      const esp: Ponto = {
        x: ESPECIAL_X,
        y: outlierLigado ? ESPECIAL_OUTLIER : ESPECIAL_NORMAL,
        tipo: "especial",
      };
      return [
        ...BASE.map(([x, y]): Ponto => ({ x, y, tipo: "base" })),
        esp,
        ...extras.map((p): Ponto => ({ ...p, tipo: "extra" })),
      ];
    }
    function metricas(pts: Ponto[]) {
      let somaAbs = 0, somaQuad = 0;
      for (const { x, y } of pts) { const e = prever(x) - y; somaAbs += Math.abs(e); somaQuad += e * e; }
      const mae = somaAbs / pts.length;
      const mse = somaQuad / pts.length;
      return { mae, mse, rmse: Math.sqrt(mse) };
    }
    // Referência: o conjunto original, sem outlier e sem pontos colocados.
    const SEM = metricas([
      ...BASE.map(([x, y]): Ponto => ({ x, y, tipo: "base" })),
      { x: ESPECIAL_X, y: ESPECIAL_NORMAL, tipo: "especial" },
    ]);

    const plot = () => ({
      x: MARGEM.esq, y: MARGEM.topo,
      w: W - MARGEM.esq - MARGEM.dir, h: H - MARGEM.topo - MARGEM.base,
    });
    const px = (x: number) => { const p = plot(); return p.x + (x - DOMINIO.xMin) / (DOMINIO.xMax - DOMINIO.xMin) * p.w; };
    const py = (y: number) => { const p = plot(); return p.y + (1 - (y - DOMINIO.yMin) / (DOMINIO.yMax - DOMINIO.yMin)) * p.h; };
    const fonte = () => getComputedStyle(document.body).fontFamily;

    function desenhar() {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      const p = plot();

      // grade
      ctx.lineWidth = 1; ctx.strokeStyle = COR.grade; ctx.fillStyle = "#8b95a5";
      ctx.font = "600 13px " + fonte();
      ctx.textAlign = "right"; ctx.textBaseline = "middle";
      for (let y = 0; y <= DOMINIO.yMax; y += 300) {
        const yy = py(y);
        ctx.beginPath(); ctx.moveTo(p.x, yy); ctx.lineTo(p.x + p.w, yy); ctx.stroke();
        ctx.fillText(nf0.format(y), p.x - 10, yy);
      }
      ctx.textAlign = "center"; ctx.textBaseline = "top";
      for (let x = 50; x <= 290; x += 50) {
        const xx = px(x);
        ctx.beginPath(); ctx.moveTo(xx, p.y); ctx.lineTo(xx, p.y + p.h); ctx.stroke();
        ctx.fillText(nf0.format(x), xx, p.y + p.h + 8);
      }
      // eixos + títulos
      ctx.strokeStyle = COR.eixo; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p.x, p.y + p.h); ctx.lineTo(p.x + p.w, p.y + p.h); ctx.stroke();
      ctx.fillStyle = COR.azulAco; ctx.font = "700 15px " + fonte();
      ctx.textAlign = "center"; ctx.textBaseline = "bottom";
      ctx.fillText("metragem (m²)", p.x + p.w / 2, H - 6);
      ctx.save(); ctx.translate(16, p.y + p.h / 2); ctx.rotate(-Math.PI / 2);
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText("preço (R$ mil)", 0, 0); ctx.restore();

      const pts = pontos();

      // resíduos
      for (const { x, y, tipo } of pts) {
        const destacado = tipo === "especial" && outlierLigado;
        ctx.strokeStyle = destacado ? COR.outlier : tipo === "extra" ? COR.extra : COR.residuo;
        ctx.lineWidth = destacado || tipo === "extra" ? 4 : 2.5;
        ctx.globalAlpha = 0.85;
        ctx.beginPath(); ctx.moveTo(px(x), py(y)); ctx.lineTo(px(x), py(prever(x))); ctx.stroke();
      }
      ctx.globalAlpha = 1;

      // reta
      ctx.save(); ctx.lineCap = "round"; ctx.lineWidth = 5;
      const g = ctx.createLinearGradient(px(DOMINIO.xMin), 0, px(DOMINIO.xMax), 0);
      g.addColorStop(0, COR.roxo); g.addColorStop(1, COR.azul); ctx.strokeStyle = g;
      ctx.beginPath();
      ctx.moveTo(px(DOMINIO.xMin), py(prever(DOMINIO.xMin)));
      ctx.lineTo(px(DOMINIO.xMax), py(prever(DOMINIO.xMax)));
      ctx.stroke(); ctx.restore();

      // pontos (os colocados na mão vêm por último, ficam por cima)
      for (const { x, y, tipo } of pts) {
        const destacado = (tipo === "especial" && outlierLigado) || tipo === "extra";
        ctx.beginPath(); ctx.arc(px(x), py(y), destacado ? 9 : 6.5, 0, Math.PI * 2);
        ctx.fillStyle = tipo === "extra" ? COR.extra : destacado ? COR.outlier : COR.ponto;
        ctx.fill();
        ctx.lineWidth = destacado ? 3 : 2; ctx.strokeStyle = "#fff"; ctx.stroke();
      }
    }

    function badge(el: HTMLElement, fator: number) {
      const forte = fator >= 4 ? COR.vermelho : fator >= 2 ? "#d97706" : COR.verde;
      el.hidden = false;
      el.innerHTML = `vs. o conjunto original: <strong style="color:${forte}">×${nf1.format(fator)}</strong>`;
    }
    function atualizar() {
      const pts = pontos();
      const m = metricas(pts);
      const mudou = outlierLigado || extras.length > 0;
      const set = (card: string, val: string, fator: number) => {
        const c = raiz.querySelector<HTMLElement>(`[data-card="${card}"]`)!;
        c.querySelector<HTMLElement>("[data-val]")!.textContent = val;
        const f = c.querySelector<HTMLElement>("[data-fator]")!;
        if (mudou) badge(f, fator); else f.hidden = true;
      };
      set("mae", nf0.format(m.mae), m.mae / SEM.mae);
      set("mse", nf0.format(m.mse), m.mse / SEM.mse);
      set("rmse", nf0.format(m.rmse), m.rmse / SEM.rmse);

      const btn = raiz.querySelector<HTMLButtonElement>("[data-toggle]")!;
      btn.textContent = outlierLigado ? "Remover outlier" : "Adicionar outlier";
      const limpar = raiz.querySelector<HTMLButtonElement>("[data-limpar]")!;
      limpar.disabled = extras.length === 0;
      limpar.textContent =
        extras.length > 1 ? `Limpar ${extras.length} pontos` : "Limpar pontos";
      desenhar();
    }

    raiz.querySelector<HTMLButtonElement>("[data-toggle]")!.addEventListener("click", () => {
      outlierLigado = !outlierLigado;
      atualizar();
    });
    raiz.querySelector<HTMLButtonElement>("[data-limpar]")!.addEventListener("click", () => {
      extras = [];
      atualizar();
    });

    // ---- colocar e tirar pontos no clique ----

    function posicaoNoCanvas(ev: MouseEvent) {
      const r = canvas!.getBoundingClientRect();
      return { cx: ev.clientX - r.left, cy: ev.clientY - r.top };
    }
    function dentroDoPlot(cx: number, cy: number) {
      const p = plot();
      return cx >= p.x && cx <= p.x + p.w && cy >= p.y && cy <= p.y + p.h;
    }
    /** Índice do ponto colocado sob o cursor, ou -1. */
    function extraSob(cx: number, cy: number) {
      for (let i = extras.length - 1; i >= 0; i--) {
        const dx = px(extras[i].x) - cx;
        const dy = py(extras[i].y) - cy;
        if (Math.hypot(dx, dy) <= RAIO_TOQUE) return i;
      }
      return -1;
    }
    function paraDados(cx: number, cy: number) {
      const p = plot();
      const x = DOMINIO.xMin + ((cx - p.x) / p.w) * (DOMINIO.xMax - DOMINIO.xMin);
      const y = DOMINIO.yMin + (1 - (cy - p.y) / p.h) * (DOMINIO.yMax - DOMINIO.yMin);
      return { x, y };
    }

    canvas.addEventListener("click", (ev) => {
      const { cx, cy } = posicaoNoCanvas(ev);
      const alvo = extraSob(cx, cy);
      if (alvo >= 0) {
        extras = extras.filter((_, i) => i !== alvo);
        atualizar();
        return;
      }
      if (!dentroDoPlot(cx, cy)) return;
      extras = [...extras, paraDados(cx, cy)];
      atualizar();
    });

    canvas.addEventListener("mousemove", (ev) => {
      const { cx, cy } = posicaoNoCanvas(ev);
      canvas.style.cursor =
        extraSob(cx, cy) >= 0 ? "pointer" : dentroDoPlot(cx, cy) ? "crosshair" : "default";
    });
    canvas.addEventListener("mouseleave", () => { canvas.style.cursor = "default"; });

    function ajustar() {
      if (!canvas || !ctx) return;
      const dpr = window.devicePixelRatio || 1;
      W = canvas.clientWidth;
      const cheia = !!document.fullscreenElement && document.fullscreenElement.contains(canvas);
      H = cheia
        ? Math.min(Math.max(window.innerHeight - 150, 420), 960)
        : Math.round(Math.min(Math.max(W * 0.62, 300), 560));
      canvas.style.height = H + "px";
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      desenhar();
    }
    new ResizeObserver(() => {
      const l = Math.round(caixa.clientWidth);
      if (l === ultimaLargura) return;
      ultimaLargura = l;
      ajustar();
    }).observe(caixa);
    document.addEventListener("fullscreenchange", () => { ultimaLargura = -1; ajustar(); });

    ajustar();
    atualizar();
  });
</script>
