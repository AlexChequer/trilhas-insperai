---
// Aula 1 · Superfície de custo J(w,b) em 3D, rotacionável, com o caminho
// do gradient descent descendo a tigela passo a passo.
---

<div class="viz-3d" data-viz="superficie">
  <div class="viz-3d-plot" data-plot></div>
  <div class="viz-controles" style="justify-content: center; margin-top: 14px;">
    <button class="btn" type="button" data-rodar>Rodar descida</button>
    <button class="btn btn-secundario" type="button" data-passo-btn>Passo a passo</button>
    <button class="btn btn-secundario" type="button" data-reiniciar>Reiniciar</button>
    <span class="viz-passo" data-passo>passo 0</span>
  </div>
  <p class="viz-3d-dica">Arraste para girar · role para dar zoom</p>
</div>

<style>
  .viz-3d-plot {
    width: 100%;
    height: clamp(340px, 52vw, 520px);
  }
  .viz-passo {
    align-self: center;
    font-family: var(--fonte-dados);
    font-weight: 600;
    color: var(--texto-suave);
  }
  .viz-3d-dica {
    margin: 8px 0 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--texto-suave);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-viz="superficie"]').forEach(async (raiz) => {
    const div = raiz.querySelector<HTMLElement>("[data-plot]");
    if (!div) return;
    const Plotly = (await import("plotly.js-dist-min")).default;

    const BASE: [number, number][] = [
      [45, 320], [60, 380], [75, 500], [90, 460], [110, 640], [125, 700],
      [140, 680], [160, 850], [175, 900], [195, 1010], [210, 980],
      [230, 1180], [250, 1220], [270, 1300],
    ];
    // Padroniza x e y → a tigela fica bem condicionada (redonda), boa pra ilustrar a descida.
    const media = (a: number[]) => a.reduce((s, v) => s + v, 0) / a.length;
    const desvio = (a: number[], m: number) => Math.sqrt(media(a.map((v) => (v - m) ** 2)));
    const xsBrutos = BASE.map((p) => p[0]);
    const ysBrutos = BASE.map((p) => p[1]);
    const mx = media(xsBrutos), sx = desvio(xsBrutos, mx);
    const my = media(ysBrutos), sy = desvio(ysBrutos, my);
    const xs = xsBrutos.map((x) => (x - mx) / sx);
    const ys = ysBrutos.map((y) => (y - my) / sy);

    const J = (w: number, b: number) => {
      let s = 0;
      for (let i = 0; i < xs.length; i++) { const e = w * xs[i] + b - ys[i]; s += e * e; }
      return s / xs.length;
    };
    const grad = (w: number, b: number) => {
      let gw = 0, gb = 0;
      for (let i = 0; i < xs.length; i++) { const e = w * xs[i] + b - ys[i]; gw += xs[i] * e; gb += e; }
      return [(2 * gw) / xs.length, (2 * gb) / xs.length];
    };

    const linspace = (a: number, b: number, n: number) =>
      Array.from({ length: n }, (_, i) => a + (b - a) * (i / (n - 1)));
    const wGrid = linspace(-0.6, 2.3, 46);
    const bGrid = linspace(-1.5, 1.5, 46);
    const Z = bGrid.map((b) => wGrid.map((w) => J(w, b)));

    // caminho do gradient descent (levantado um tico acima da superfície pra não sumir atrás dela)
    const LIFT = 0.18;
    const LR = 0.12, PASSOS = 28;
    const caminho: { w: number; b: number; J: number }[] = [];
    let w = 2.0, b = 1.15;
    caminho.push({ w, b, J: J(w, b) });
    for (let i = 0; i < PASSOS; i++) {
      const [gw, gb] = grad(w, b);
      w -= LR * gw; b -= LR * gb;
      caminho.push({ w, b, J: J(w, b) });
    }

    const superficie = {
      type: "surface", x: wGrid, y: bGrid, z: Z,
      colorscale: [[0, "#dbe4ff"], [0.5, "#7c3aed"], [1, "#1e3a8a"]],
      opacity: 0.92, showscale: false,
      contours: { z: { show: true, usecolormap: true, width: 1, project: { z: false } } },
      hoverinfo: "skip",
    };
    const traco = {
      type: "scatter3d", mode: "lines+markers",
      x: [caminho[0].w], y: [caminho[0].b], z: [caminho[0].J + LIFT],
      line: { color: "#f4603e", width: 8 }, marker: { size: 4, color: "#f4603e" },
      hoverinfo: "skip",
    };
    const bola = {
      type: "scatter3d", mode: "markers",
      x: [caminho[0].w], y: [caminho[0].b], z: [caminho[0].J + LIFT],
      marker: { size: 9, color: "#dc2626", line: { color: "#fff", width: 1 } }, hoverinfo: "skip",
    };

    const layout = {
      margin: { l: 0, r: 0, t: 0, b: 0 },
      showlegend: false,
      scene: {
        // uirevision preserva a câmera do usuário entre atualizações — sem isso, cada
        // passo da animação reaplicava a câmera inicial e "travava" a rotação.
        uirevision: "descida",
        xaxis: { title: { text: "w" }, backgroundcolor: "#f5f8fd", gridcolor: "#dbe2ee" },
        yaxis: { title: { text: "b" }, backgroundcolor: "#f5f8fd", gridcolor: "#dbe2ee" },
        zaxis: { title: { text: "custo" }, backgroundcolor: "#f5f8fd", gridcolor: "#dbe2ee" },
        camera: { eye: { x: 1.7, y: 1.6, z: 1.0 } },
      },
      paper_bgcolor: "rgba(0,0,0,0)",
    };
    const config = { responsive: true, displayModeBar: false, scrollZoom: true };

    await Plotly.newPlot(div, [superficie, traco, bola], layout, config);

    // Frames pré-computados: animar por frames (em vez de restyle) atualiza os
    // traços sem recriar a cena 3D — a rotação continua viva durante a descida.
    const frames = caminho.map((p, i) => ({
      name: "f" + i,
      data: [
        {
          x: caminho.slice(0, i + 1).map((q) => q.w),
          y: caminho.slice(0, i + 1).map((q) => q.b),
          z: caminho.slice(0, i + 1).map((q) => q.J + LIFT),
        },
        { x: [p.w], y: [p.b], z: [p.J + LIFT] },
      ],
      traces: [1, 2],
    }));
    await Plotly.addFrames(div, frames);

    const elPasso = raiz.querySelector<HTMLElement>("[data-passo]");
    let passo = 0;
    let timer: number | null = null;
    let interagindo = false;

    // Enquanto o usuário mexe no gráfico (girar/zoom), pausa o avanço para não
    // interromper o gesto. Ao soltar, a descida continua de onde parou.
    div.addEventListener("mousedown", () => { interagindo = true; });
    div.addEventListener("touchstart", () => { interagindo = true; }, { passive: true });
    window.addEventListener("mouseup", () => { interagindo = false; });
    window.addEventListener("touchend", () => { interagindo = false; });

    function mostrar(i: number) {
      passo = i;
      Plotly.animate(div, ["f" + i], {
        mode: "immediate",
        frame: { duration: 0, redraw: true },
        transition: { duration: 0 },
      });
      if (elPasso) elPasso.textContent = "passo " + i;
    }
    function parar() {
      if (timer !== null) { window.clearInterval(timer); timer = null; }
    }
    function rodar() {
      if (timer !== null) return;
      if (passo >= PASSOS) mostrar(0);
      timer = window.setInterval(() => {
        if (interagindo) return; // não avança enquanto o usuário gira o gráfico
        if (passo >= PASSOS) { parar(); return; }
        mostrar(passo + 1);
      }, 540);
    }
    function passoUnico() {
      parar();
      if (passo < PASSOS) mostrar(passo + 1);
    }
    function reiniciar() {
      parar();
      mostrar(0);
    }
    raiz.querySelector<HTMLButtonElement>("[data-rodar]")!.addEventListener("click", rodar);
    raiz.querySelector<HTMLButtonElement>("[data-passo-btn]")!.addEventListener("click", passoUnico);
    raiz.querySelector<HTMLButtonElement>("[data-reiniciar]")!.addEventListener("click", reiniciar);

    // acompanha mudança de tamanho (coluna, tela cheia)
    new ResizeObserver(() => Plotly.Plots.resize(div)).observe(div);
    document.addEventListener("fullscreenchange", () => setTimeout(() => Plotly.Plots.resize(div), 60));
  });
</script>
