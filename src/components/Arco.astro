---
// O arco: as 13 aulas como uma trilha de estações, agrupadas pelos seis blocos.
// É a assinatura do site e o índice visual do semestre — e é só da home, para
// não repetir o que a barra lateral já faz dentro das aulas.
//
// Cada bloco é uma perna da trilha, com a cor interpolada do roxo (começo) ao
// azul (fim): a viagem "de uma reta até um agente que aprende" fica no gradiente.
import { getCollection } from "astro:content";
import { BLOCOS } from "../data/aulas";

const escritas = new Set((await getCollection("aulas")).map((e) => e.id));

const INICIO = [124, 58, 237]; // --insper-roxo
const FIM = [37, 99, 235]; // --insper-azul
const corDoBloco = (i: number) => {
  const t = BLOCOS.length > 1 ? i / (BLOCOS.length - 1) : 0;
  const c = INICIO.map((v, k) => Math.round(v + (FIM[k] - v) * t));
  return `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
};
---

<section class="arco" id="o-arco">
  <div class="arco-cabecalho">
    <h2>O semestre inteiro</h2>
    <p>
      Treze aulas em sequência: cada uma usa o que a anterior deixou pronto. Clique
      em qualquer estação para ir direto.
    </p>
  </div>

  <ol class="arco-trilha">
    {
      BLOCOS.map((bloco, i) => (
        <li class="arco-perna" style={`--cor-bloco: ${corDoBloco(i)}`}>
          <p class="arco-perna-nome">{bloco.curto}</p>
          <p class="arco-perna-resumo">{bloco.resumo}</p>
          <div class="arco-estacoes">
            {bloco.aulas.map((a) => {
              const temPagina = escritas.has(a.slug);
              const conteudo = (
                <>
                  <span class="arco-ponto">{a.n}</span>
                  <span class="arco-titulo">{a.titulo}</span>
                </>
              );
              return temPagina ? (
                <a href={`/aulas/${a.slug}`} class="arco-estacao" title={a.desc}>
                  {conteudo}
                </a>
              ) : (
                <span class="arco-estacao muda" title="em breve">
                  {conteudo}
                </span>
              );
            })}
          </div>
        </li>
      ))
    }
  </ol>
</section>
