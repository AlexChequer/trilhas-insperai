---
// Barra fixa no topo, em todas as páginas: logo, o seletor de trilhas, as seções
// da trilha atual e a busca.
//
// A lateral mostra só o índice da trilha onde você está — antes ela carregava
// tudo e ia crescer sem fim conforme Projetos e Recursos entrassem.
//
// Duas navegações, em ordem de importância: as TRILHAS (a navegação real do
// site) e as SEÇÕES da trilha atual (Projetos e Recursos ainda não existem;
// aparecem marcadas "em breve" e não são links, para não haver caminho que não
// leva a lugar nenhum). Quando o espaço aperta, as seções somem primeiro.
import { TRILHAS, urlTrilha, type Trilha } from "../data/trilhas";

interface Props {
  /** A trilha atual. Ausente no hub, que é justamente a página de todas. */
  trilha?: Trilha;
  /** Qual seção está ativa: destaca o item na barra. */
  secao?: "aulas" | "projetos" | "recursos";
  /** A página tem índice lateral? Só então o botão ☰ do celular faz sentido. */
  temLateral?: boolean;
}
const { trilha, secao, temLateral = false } = Astro.props;

const SECOES = [
  { id: "aulas", rotulo: "Aulas", href: trilha ? `${urlTrilha(trilha.id)}#o-arco` : null },
  { id: "projetos", rotulo: "Projetos", href: null },
  { id: "recursos", rotulo: "Recursos", href: null },
] as const;
---

<header class="barra-topo">
  {
    temLateral && (
      <button class="menu-btn" type="button" aria-label="Abrir índice" data-menu>
        ☰
      </button>
    )
  }

  <a href="/" class="barra-marca" aria-label="Início — as trilhas da InsperAI">
    <span class="barra-marca-simbolo" aria-hidden="true"></span>
    <span class="barra-marca-texto">
      <b>InsperAI</b>
      <em>{trilha ? trilha.nome : "Trilhas da entidade"}</em>
    </span>
  </a>

  <nav class="barra-trilhas" aria-label="Trilhas">
    {
      TRILHAS.map((t) => {
        const noAr = t.blocos.length > 0;
        const atual = t.id === trilha?.id;
        if (!noAr) {
          return (
            <span class="barra-secao muda">
              {t.curto}
              <em>em breve</em>
            </span>
          );
        }
        return (
          <a
            href={urlTrilha(t.id)}
            class={"barra-secao" + (atual ? " ativa" : "")}
            aria-current={atual ? "page" : undefined}
          >
            {t.curto}
          </a>
        );
      })
    }
  </nav>

  {
    trilha && (
      <nav class="barra-secoes" aria-label={`Seções — ${trilha.nome}`}>
        {SECOES.map((s) =>
          s.href ? (
            <a href={s.href} class={"barra-secao" + (secao === s.id ? " ativa" : "")}>
              {s.rotulo}
            </a>
          ) : (
            <span class="barra-secao muda">
              {s.rotulo}
              <em>em breve</em>
            </span>
          ),
        )}
      </nav>
    )
  }

  <button class="barra-busca" type="button" data-abrir-busca aria-label="Buscar no site">
    <span class="barra-busca-lupa" aria-hidden="true">⌕</span>
    <span class="barra-busca-texto">Buscar</span>
    <kbd class="barra-busca-tecla">/</kbd>
  </button>
</header>
