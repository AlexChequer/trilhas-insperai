---
// Endereço antigo: /aulas/aula-01 → /trainees/aulas/aula-01.
// Quando o site era só o da trilha de trainees, as aulas moravam na raiz. Estes
// redirecionamentos existem pelos links que os trainees já têm salvos — só para
// as aulas daquela trilha, que são as únicas que já estiveram aqui.
import { getCollection } from "astro:content";
import Redirecionar from "@/components/Redirecionar.astro";
import { daTrilha, separarId, urlAula } from "@/data/trilhas";

export async function getStaticPaths() {
  const aulas = await getCollection("aulas", daTrilha("trainees"));
  return aulas.map((entry) => {
    const { slug } = separarId(entry.id);
    return { params: { slug }, props: { para: urlAula("trainees", slug) } };
  });
}

const { para } = Astro.props;
---

<Redirecionar para={para} />
