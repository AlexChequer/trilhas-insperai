---
// Endereço antigo: /guias/aula-0 → /trainees/guias/aula-0. Ver o irmão em
// src/pages/aulas/[slug].astro para o porquê.
import { getCollection } from "astro:content";
import Redirecionar from "@/components/Redirecionar.astro";
import { daTrilha, separarId, urlGuia } from "@/data/trilhas";

export async function getStaticPaths() {
  const guias = await getCollection("guias", daTrilha("trainees"));
  return guias.map((entry) => {
    const { slug } = separarId(entry.id);
    return { params: { slug }, props: { para: urlGuia("trainees", slug) } };
  });
}

const { para } = Astro.props;
---

<Redirecionar para={para} />
