---
// O hub: a porta de entrada única da entidade. Não é a home de nenhuma trilha —
// é a página que mostra quais existem e manda a pessoa para a certa.
//
// Uma trilha sem arco aparece aqui como "em breve", sem link: assim ela já é
// visível (a entidade sabe o que vem) sem que exista caminho para uma página vazia.
import { getCollection } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { TRILHAS, separarId, urlTrilha } from "@/data/trilhas";

const escritas = (await getCollection("aulas")).map((e) => separarId(e.id).trilha);

const cartoes = TRILHAS.map((trilha) => {
  const planejadas = trilha.blocos.reduce((soma, b) => soma + b.aulas.length, 0);
  const noAr = escritas.filter((id) => id === trilha.id).length;
  return { trilha, planejadas, noAr, aberta: trilha.blocos.length > 0 };
});
---

<SiteLayout
  title="InsperAI — as trilhas da entidade"
  descricao="As trilhas de estudo da InsperAI: trainees, deploy de agentes e ML/DL avançado."
  semLateral
>
  <div class="home">
    <section class="home-hero">
      <p class="home-eyebrow">InsperAI · 2º semestre de 2026</p>
      <h1>As <em>trilhas</em> da entidade.</h1>
      <p class="home-sub">
        Cada trilha é um curso completo, com o conteúdo aberto para qualquer membro
        ler no próprio ritmo. Escolha por onde entrar.
      </p>
    </section>

    <section class="hub">
      <ul class="hub-grade">
        {
          cartoes.map(({ trilha, planejadas, noAr, aberta }) => {
            const conteudo = (
              <>
                <p class="hub-card-nome">{trilha.curto}</p>
                <p class="hub-card-titulo">{trilha.nome}</p>
                <p class="hub-card-resumo">{trilha.resumo}</p>
                <p class="hub-card-publico">{trilha.publico}</p>
                <p class="hub-card-rodape">
                  {aberta ? (
                    <>
                      <span class="hub-card-ritmo">{trilha.ritmo}</span>
                      <span class="hub-card-progresso">{noAr} de {planejadas} no ar</span>
                    </>
                  ) : (
                    <span class="hub-card-ritmo">em breve</span>
                  )}
                </p>
              </>
            );

            return (
              <li>
                {aberta ? (
                  <a class="hub-card" href={urlTrilha(trilha.id)}>
                    {conteudo}
                  </a>
                ) : (
                  <span class="hub-card muda">{conteudo}</span>
                )}
              </li>
            );
          })
        }
      </ul>
    </section>
  </div>
</SiteLayout>
