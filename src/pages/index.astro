---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { BLOCOS } from "../data/aulas";

const escritas = new Set((await getCollection("aulas")).map((e) => e.id));

let prontas = 0;
let total = 0;
for (const bloco of BLOCOS) {
  for (const a of bloco.aulas) {
    prontas += a.prontas;
    total += a.total;
  }
}
const pct = total ? Math.round((prontas / total) * 100) : 0;

// resumo curto de cada bloco (aparece no card)
const RESUMO: Record<string, string> = {
  "Bloco 1 · Fundamentos": "Regressão, custo, gradient descent e classificação.",
  "Bloco 2 · Redes Neurais": "Do neurônio ao MLP, backprop e o treino na prática.",
  "Bloco 3 · Ferramentas": "Usar IA para programar — e revisar o que ela produz.",
  "Bloco 4 · Visão": "Convolução, CNNs e transfer learning.",
  "Bloco 5 · Linguagem (em aberto)": "Embeddings e modelos de linguagem.",
  "Bloco 6 · Fronteira": "Reinforcement learning e o fechamento do arco.",
};
---

<SiteLayout title="Trilha de Trainees — InsperAI">
  <div class="landing">
    <section class="landing-hero">
      <p class="landing-eyebrow">InsperAI · Programa de Trainee · 2º semestre de 2026</p>
      <h1>De uma <em>reta</em> até um <em>agente que aprende</em>.</h1>
      <p class="landing-sub">
        Treze aulas, um arco só. Cada visualização deixa você mexer em uma coisa e
        ver a consequência na hora — que é como esses conceitos entram na cabeça de
        verdade.
      </p>
      <div class="landing-acoes">
        <a class="btn" href="/aulas/aula-01/">Começar pela Aula 1 →</a>
        <div class="landing-progresso">
          <span>{prontas} de {total} visualizações prontas</span>
          <div class="landing-barra"><i style={`width:${pct}%`}></i></div>
        </div>
      </div>
    </section>

    <section class="blocos">
      <h2 class="blocos-titulo">O semestre em seis blocos</h2>
      <div class="blocos-grid">
        {
          BLOCOS.map((bloco) => {
            const prontasBloco = bloco.aulas.filter((a) => escritas.has(a.slug)).length;
            return (
              <div class="bloco-card">
                <p class="bloco-card-nome">{bloco.nome}</p>
                <p class="bloco-card-resumo">{RESUMO[bloco.nome] ?? ""}</p>
                <div class="bloco-card-aulas">
                  {bloco.aulas.map((a) => {
                    const temPagina = escritas.has(a.slug);
                    return temPagina ? (
                      <a href={`/aulas/${a.slug}`} class="mini-aula">
                        <span class="mini-codigo">{a.n}</span>
                        {a.titulo}
                      </a>
                    ) : (
                      <span class="mini-aula muda">
                        <span class="mini-codigo">{a.n}</span>
                        {a.titulo}
                      </span>
                    );
                  })}
                </div>
                {prontasBloco > 0 && (
                  <span class="bloco-card-selo">{prontasBloco} pronta{prontasBloco > 1 ? "s" : ""}</span>
                )}
              </div>
            );
          })
        }
      </div>
    </section>
  </div>
</SiteLayout>
